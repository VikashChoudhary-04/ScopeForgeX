03c/div\u003e\r\n              \u003cdiv class=\"ts-facts-content\"\u003e\r\n                \u003ch2 class=\"ts-facts-num\"\u003e\r\n                  \u003cspan class=\"counterUp\" data-start=\"550\"   data-count=\"647\" data-specific-number=\"750\"\u003e647\u003c/span\u003e\r\n                \u003c/h2\u003e\r\n                \u003ch2 class=\"ts-facts-title text-white\"\u003eHappy Clients\u003c/h2\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e --\u003e\r\n            \u003c!-- Col end --\u003e\r\n\r\n            \u003c!-- \u003cdiv class=\"col-md-3 col-sm-6 ts-facts mt-5 mt-md-0\"\u003e\r\n              \u003cdiv class=\"ts-facts-img\"\u003e\r\n                \u003ci\r\n                  class=\"fa-solid fa-award\"\r\n                  style=\"font-size: 35px\"\r\n                  aria-hidden=\"true\"\r\n                \u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003cdiv class=\"ts-facts-content\"\u003e\r\n                \u003ch2 class=\"ts-facts-num\"\u003e\r\n                  \u003cspan class=\"counterUp\" data-start=\"3900\" data-count=\"4000\" data-specific-number=\"4400\"\u003e4000\u003c/span\u003e\r\n                \u003c/h2\u003e\r\n                \u003ch3 class=\"ts-facts-title text-white\"\u003eAwards Achieved\u003c/h3\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e --\u003e\r\n\r\n            \u003c!-- \u003cdiv class=\"col-md-3 col-sm-6 ts-facts mt-5 mt-md-0\"\u003e\r\n              \u003cdiv class=\"ts-facts-img\"\u003e\r\n                \u003ci\r\n                  class=\"fa-solid fa-user-plus\"\r\n                  style=\"font-size: 35px\"\r\n                  aria-hidden=\"true\"\r\n                \u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003cdiv class=\"ts-facts-content\"\u003e\r\n                \u003ch2 class=\"ts-facts-num\"\u003e\r\n                  \u003cspan class=\"counterUp\" data-start=\"0\" data-count=\"44\" data-specific-number=\"57\"\u003e44\u003c/span\u003e\r\n                \u003c/h2\u003e\r\n                \u003ch3 class=\"ts-facts-title text-white\"\u003eTeam Members\u003c/h3\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e --\u003e\r\n\r\n    \u003c!-- Extended Warranty Service Sections Start --\u003e\r\n    \u003cdiv class=\"container-xxl py-5 workimg\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"text-center mx-auto\" style=\"max-width: 700px\"\u003e\r\n          \u003ch1 class=\"section-sub-title mb-5\" style=\"   font-weight: 700;\r\n    font-size: 30px;\r\n    line-height: 1.3;\r\n    margin: 0 0 60px;\r\n    color: #212121;\r\n    text-transform: uppercase;\"\u003eExtended Warranty Solutions\u003c/h1\u003e\r\n        \u003c/div\u003e\r\n       \u003cdiv class=\"row g-4 justify-content-evenly\"\u003e\r\n  \u003cdiv class=\"col-lg-4 col-md-6 wow fadeInUp\" data-wow-delay=\"0.1s\"\u003e\r\n    \u003cdiv\r\n      class=\"service-item rounded h-100 p-4 d-flex flex-column\"\r\n      style=\"\r\n        background-color: #f8f9fa;\r\n        border-left: 4px solid #2d286b;\r\n        transition: transform 0.3s ease-in-out;\r\n        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);\r\n        height: 100%;\r\n      \"\r\n    \u003e\r\n      \u003cdiv class=\"d-flex align-items-center mb-3\"\u003e\r\n        \u003cdiv\r\n          class=\"service-icon flex-shrink-0 rounded-circle me-3\"\r\n          style=\"\r\n            background-color: #2d286b;\r\n            border: 2px solid #2d286b;\r\n            padding: 12px;\r\n          \"\r\n        \u003e\r\n          \u003cimg\r\n            class=\"img-fluid\"\r\n            src=\"img/icon/icon-08-light.png\"\r\n            alt=\"\"\r\n            style=\"width: 35px; height: 35px\"\r\n          /\u003e\r\n        \u003c/div\u003e\r\n        \u003ch4\r\n          class=\"text-dark mb-0\"\r\n          style=\"\r\n            font-weight: 700 !important;\r\n            font-size: 1.1rem;\r\n        \r\n          \"\r\n        \u003e\r\n          Automobiles \r\n        \u003c/h4\u003e\r\n      \u003c/div\u003e\r\n      \u003cp\r\n        class=\"text-dark mb-4 flex-grow-1\"\r\n        style=\"font-size: 16px; font-weight: 400; line-height: 1.5;color:#3b3b3b!important;font-family: Poppins;\"\r\n      \u003e\r\n        Your Automobile is more than transportation, it’s an investment. Our complete coverage protects you from unexpected repair costs, giving you the freedom to enjoy every journey with complete peace of mind.      \u003c/p\u003e\r\n      \u003cdiv class=\"mt-auto\"\u003e\r\n        \u003ca\r\n          class=\"btn btn-outline-primary px-4 py-2 d-inline-block\"\r\n          href=\"services.html\"\r\n          style=\"font-family: Poppins;\r\n            font-size: 14px;\r\n            font-weight: 400;\r\n            border-radius: 25px;\r\n            color: #2d286b;\r\n            border: 2px solid #2d286b;\r\n            text-transform: uppercase;\r\n            transition: background-color 0.3s ease;\r\n            padding-left: 30px;\r\n            padding-right: 30px;\r\n          \"\r\n        \u003e\r\n          Learn More\r\n        \u003c/a\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003cdiv class=\"col-lg-4 col-md-6 wow fadeInUp\" data-wow-delay=\"0.3s\"\u003e\r\n    \u003cdiv\r\n      class=\"service-item rounded h-100 p-4 d-flex flex-column\"\r\n      style=\"\r\n        background-color: #f8f9fa;\r\n        border-left: 4px solid #28a745;\r\n        transition: transform 0.3s ease-in-out;\r\n        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);\r\n        height: 100%;\r\n      \"\r\n    \u003e\r\n      \u003cdiv class=\"d-flex align-items-center mb-3\"\u003e\r\n        \u003cdiv\r\n          class=\"service-icon flex-shrink-0 rounded-circle me-3\"\r\n          style=\"\r\n            background-color: #28a745;\r\n            border: 2px solid #28a745;\r\n            padding: 12px;\r\n          \"\r\n        \u003e\r\n          \u003cimg\r\n            class=\"img-fluid\"\r\n            src=\"img/icon/icon-05-light.png\"\r\n            alt=\"\"\r\n            style=\"width: 35px; height: 35px\"\r\n          /\u003e\r\n        \u003c/div\u003e\r\n        \u003ch4\r\n          class=\"text-dark mb-0\"\r\n          style=\"\r\n           font-weight: 700 !important;\r\n            font-size: 1.1rem;\r\n          \"\r\n        \u003e\r\n          Electronics \u0026 Consumer Durables \r\n        \u003c/h4\u003e\r\n      \u003c/div\u003e\r\n      \u003cp\r\n        class=\"text-dark mb-4 flex-grow-1\"\r\n        style=\"font-size: 16px; font-weight: 400; line-height: 1.5;color:#3b3b3b!important;font-family: Poppins;\"\r\n      \u003e\r\n        We offer comprehensive coverage for a wide range of electronic devices, shielding you from unexpected repairs and ensuring your gadgets continue to perform reliably.      \u003c/p\u003e\r\n      \u003cdiv class=\"mt-auto\"\u003e\r\n        \u003ca\r\n          class=\"btn btn-outline-primary px-4 py-2 d-inline-block\"\r\n          href=\"#\"\r\n          style=\"font-family: Poppins;\r\n            font-size: 14px;\r\n            font-weight: 400;\r\n            border-radius: 25px;\r\n            color: #28a745;\r\n            border: 2px solid #28a745;\r\n            text-transform: uppercase;\r\n            transition: background-color 0.3s ease;\r\n            padding-left: 30px;\r\n            padding-right: 30px;\r\n          \"\r\n        \u003e\r\n          Learn More\r\n        \u003c/a\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n  \r\n  \u003cdiv class=\"col-lg-4 col-md-6 wow fadeInUp\" data-wow-delay=\"0.3s\"\u003e\r\n    \u003cdiv\r\n      class=\"service-item rounded h-100 p-4 d-flex flex-column\"\r\n      style=\"\r\n        background-color: #f8f9fa;\r\n        border-left: 4px solid #ff8c00;\r\n        transition: transform 0.3s ease-in-out;\r\n        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);\r\n        height: 100%;\r\n      \"\r\n    \u003e\r\n      \u003cdiv class=\"d-flex align-items-center mb-3\"\u003e\r\n        \u003cdiv\r\n          class=\"service-icon flex-shrink-0 rounded-circle me-3\"\r\n          style=\"\r\n            background-color: #ff8c00;\r\n            border: 2px solid #ff8c00;\r\n            padding: 12px;\r\n          \"\r\n        \u003e\r\n           \u003cimg\r\n            class=\"img-fluid\"\r\n            src=\"img/icon/icon-08-light.png\"\r\n            alt=\"\"\r\n            style=\"width: 35px; height: 35px\"\r\n          /\u003e\r\n        \u003c/div\u003e\r\n        \u003ch4\r\n          class=\"text-dark mb-0\"\r\n          style=\"\r\n           font-weight: 700 !important;\r\n            font-size: 1.1rem;\r\n          \"\r\n        \u003e\r\nPre-Owned Vehicle\r\n        \u003c/h4\u003e\r\n      \u003c/div\u003e\r\n      \u003cp\r\n        class=\"text-dark mb-4 flex-grow-1\"\r\n        style=\"font-size: 16px; font-weight: 400; line-height: 1.5;color:#3b3b3b!important;font-family: Poppins;\"\r\n      \u003e\r\n       Explore our pre-owned vehicle warranty solutions and drive with confidence, knowing your investment is protected.      \u003c/p\u003e\r\n      \u003cdiv class=\"mt-auto\"\u003e\r\n        \u003ca\r\n          class=\"btn btn-outline-primary px-4 py-2 d-inline-block\"\r\n          href=\"https://truepromise.co.in/warranty/\"\r\n          style=\"font-family: Poppins;\r\n            font-size: 14px;\r\n            font-weight: 400;\r\n            border-radius: 25px;\r\n            color: #ff8c00;\r\n            border: 2px solid #ff8c00;\r\n            text-transform: uppercase;\r\n            transition: background-color 0.3s ease;\r\n            padding-left: 30px;\r\n            padding-right: 30px;\r\n          \"\r\n        \u003e\r\n          Learn More\r\n        \u003c/a\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003c!-- Extended Warranty Service Sections End --\u003e\r\n\r\n\u003cstyle\u003e\r\n.service-box-title a {\r\n  display: inline-block;\r\n  padding: 5px 14px;\r\n  border-radius: 8px;\r\n  background: linear-gradient(\r\n    to right,\r\n    rgba(45, 40, 107, 0.22),   /* ✅ darker */\r\n    rgba(45, 40, 107, 0.12)\r\n  );\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.service-box-title a:hover {\r\n  background: linear-gradient(\r\n    to right,\r\n    rgba(45, 40, 107, 0.35),   /* ✅ darker hover */\r\n    rgba(45, 40, 107, 0.20)\r\n  );\r\n}\r\n\r\n/* Make \u003cp\u003e clickable */\r\n.ts-service-box-info p {\r\n  cursor: pointer;\r\n  color:#3b3b3b!important;\r\n  transition: color 0.3s ease;\r\n}\r\n\r\n.logo-slider {\r\n  overflow: hidden;\r\n  position: relative;\r\n  width: 100%;\r\n  padding: 0px;\r\n  margin:0px;\r\n}\r\n\r\n.logo-track {\r\n  display: flex;\r\n  width: calc(250px * 14); /* (Logo width × Total logos including duplicates) */\r\n  animation: scroll 20s linear infinite;\r\n}\r\n\r\n.client-logo {\r\n  height: 80px;\r\n  width: auto;\r\n  margin: 0 40px;\r\n  object-fit: contain;\r\n  filter: grayscale(0%);\r\n  transition: transform 0.3s;\r\n}\r\n\r\n.client-logo:hover {\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* Animation */\r\n@keyframes scroll {\r\n  0% { transform: translateX(0); }\r\n  100% { transform: translateX(-50%); }\r\n}\r\n\r\n\u003c/style\u003e\r\n\r\n    \u003c!--\u003csection id=\"ts-service-area\" class=\"ts-service-area pb-0\"\u003e--\u003e\r\n    \u003c!--  \u003cdiv class=\"container\"\u003e--\u003e\r\n    \r\n    \u003c!--    \u003cdiv class=\"row text-center\"\u003e--\u003e\r\n    \u003c!--      \u003cdiv class=\"col-12\"\u003e--\u003e\r\n    \u003c!--       \u003ch2 class=\"section-sub-title\" style='   font-weight: 700;--\u003e\r\n    \u003c!--font-size: 30px;--\u003e\r\n    \u003c!--line-height: 1.3;--\u003e\r\n    \u003c!--margin: 0 0 60px;--\u003e\r\n    \u003c!--color: #212121;'\u003eOur Service Offerings\u003c/h2\u003e--\u003e\r\n\r\n    \u003c!--      \u003c/div\u003e--\u003e\r\n    \u003c!--    \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--    \u003cdiv class=\"row\"\u003e--\u003e\r\n    \r\n          \u003c!-- LEFT COLUMN --\u003e\r\n    \u003c!--      \u003cdiv class=\"col-lg-4\"\u003e--\u003e\r\n    \r\n    \u003c!--        \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e\r\n    \u003c!--            \u003ci class=\"fa-solid fa-shield-halved\" style=\"font-size: 30px\"\u003e\u003c/i\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e\r\n    \u003c!--            \u003ch3 class=\"service-box-title\"\u003e--\u003e\r\n    \u003c!--              \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/Auto_Mobile.jpg')\" style = 'font-weight: 700 !important;--\u003e\r\n    \u003c!--        font-size: 1.1rem;color:#fff;background-color:#2d286b'\u003eAutomobile  Services\u003c/a\u003e--\u003e\r\n    \u003c!--            \u003c/h3\u003e--\u003e\r\n    \u003c!--            \u003cp onclick=\"switchImage('./img/Auto_Mobile.jpg')\"\u003e--\u003e\r\n    \u003c!--           Expert repair and maintenance for Automobile to keep your automobile running smoothly and reliably.--\u003e\r\n    \u003c!--            \u003c/p\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--        \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--        \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e\r\n    \u003c!--            \u003ci class=\"fa-solid fa-house\" style=\"font-size: 30px;\"\u003e\u003c/i\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e\r\n    \u003c!--            \u003ch3 class=\"service-box-title\"\u003e--\u003e\r\n    \u003c!--              \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/Home_appliances.jpg')\" style = 'font-weight: 700 !important;--\u003e\r\n    \u003c!--        font-size: 1.1rem;color:#fff;background-color:#2d286b'\u003eHome Appliance Repair\u003c/a\u003e--\u003e\r\n    \u003c!--            \u003c/h3\u003e--\u003e\r\n    \u003c!--            \u003cp onclick=\"switchImage('./img/Home_appliances.jpg')\"\u003e--\u003e\r\n    \u003c!--               Professional repair services for refrigerators, washing machines,ACs,and other essential home appliances.--\u003e\r\n    \u003c!--            \u003c/p\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--        \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--        \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e\r\n    \u003c!--            \u003ci class=\"fa-regular fa-file\" style=\"font-size: 30px\"\u003e\u003c/i\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e\r\n    \u003c!--            \u003ch3 class=\"service-box-title\"\u003e--\u003e\r\n    \u003c!--              \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/EV.jpg')\" style = 'font-weight: 700 !important;--\u003e\r\n    \u003c!--        font-size: 1.1rem;color:#fff;background-color:#2d286b'\u003eElectric Automobile \u003c/a\u003e--\u003e\r\n    \u003c!--            \u003c/h3\u003e--\u003e\r\n    \u003c!--            \u003cp onclick=\"switchImage('./img/EV.jpg')\"\u003e--\u003e\r\n    \u003c!--               Specialized repair and diagnostics for electric automobile to ensure safety, performance, and efficiency.--\u003e\r\n    \u003c!--            \u003c/p\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--        \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--      \u003c/div\u003e--\u003e\r\n    \r\n          \u003c!-- CENTER IMAGE --\u003e\r\n    \u003c!--      \u003cdiv class=\"col-lg-4 text-center\"\u003e--\u003e\r\n    \u003c!--        \u003cimg--\u003e\r\n    \u003c!--          id=\"servicePreview\"--\u003e\r\n    \u003c!--          loading=\"lazy\"--\u003e\r\n    \u003c!--          class=\"img-fluid\"--\u003e\r\n    \u003c!--          src=\"./img/mechanic.png\"--\u003e\r\n    \u003c!--          alt=\"service-avater-image\"--\u003e\r\n    \u003c!--          style=\"border-radius: 20px; --\u003e\r\n    \u003c!--                 box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);--\u003e\r\n    \u003c!--                 transition: all 0.4s ease, opacity 0.4s ease;\"--\u003e\r\n    \u003c!--        /\u003e--\u003e\r\n    \u003c!--      \u003c/div\u003e--\u003e\r\n    \r\n          \u003c!-- RIGHT COLUMN --\u003e\r\n    \u003c!--      \u003cdiv class=\"col-lg-4\"\u003e--\u003e\r\n    \r\n    \u003c!--        \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e\r\n    \u003c!--            \u003ci class=\"fa-solid fa-circle-check\" style=\"font-size: 30px;\"\u003e\u003c/i\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e\r\n    \u003c!--            \u003ch3 class=\"service-box-title\"\u003e--\u003e\r\n    \u003c!--              \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/EV.jpg')\" style = 'font-weight: 700 !important;--\u003e\r\n    \u003c!--        font-size: 1.1rem;color:#fff;background-color:#2d286b'\u003eHassle-Free Claims\u003c/a\u003e--\u003e\r\n    \u003c!--            \u003c/h3\u003e--\u003e\r\n    \u003c!--            \u003cp onclick=\"switchImage('./img/EV.jpg')\"\u003e--\u003e\r\n    \u003c!--              Quick, transparent, and paperless repair process designed to save your time and effort.--\u003e\r\n    \u003c!--            \u003c/p\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--        \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--        \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e\r\n    \u003c!--            \u003ci class=\"fa-solid fa-indian-rupee-sign\" style=\"font-size: 30px\"\u003e\u003c/i\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e\r\n    \u003c!--            \u003ch3 class=\"service-box-title\"\u003e--\u003e\r\n    \u003c!--              \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/Auto_Mobile.jpg')\" style=\"font-weight: 700 !important;--\u003e\r\n    \u003c!--        font-size: 1.1rem;color:#fff;background-color:#2d286b\"\u003eCost-Effective \u003c/a\u003e--\u003e\r\n    \u003c!--            \u003c/h3\u003e--\u003e\r\n    \u003c!--            \u003cp onclick=\"switchImage('./img/Auto_Mobile.jpg')\"\u003e--\u003e\r\n    \u003c!--                Affordable repair solutions that help you avoid expensive breakdowns and unexpected repair costs.--\u003e\r\n    \u003c!--            \u003c/p\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--        \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--        \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e\r\n    \u003c!--            \u003ci class=\"fa-solid fa-headphones-simple\" style=\"font-size: 30px\"\u003e\u003c/i\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--          \u003cdiv class=\"ts-service-box-info\" style=\"margin-left:18px\"\u003e--\u003e\r\n    \u003c!--            \u003ch3 class=\"service-box-title\"\u003e--\u003e\r\n    \u003c!--              \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/24X7.jpg')\" style=\"font-weight: 700 !important;--\u003e\r\n    \u003c!--        font-size: 1.1rem;color:#fff;background-color:#2d286b\"\u003e24 x 7 Assistance\u003c/a\u003e--\u003e\r\n    \u003c!--            \u003c/h3\u003e--\u003e\r\n    \u003c!--            \u003cp onclick=\"switchImage('./img/24X7.jpg')\"\u003e--\u003e\r\n    \u003c!--                Quick support that makes claims effortless.--\u003e\r\n    \u003c!--            \u003c/p\u003e--\u003e\r\n    \u003c!--          \u003c/div\u003e--\u003e\r\n    \u003c!--        \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--      \u003c/div\u003e--\u003e\r\n    \r\n    \u003c!--    \u003c/div\u003e--\u003e\r\n    \u003c!--  \u003c/div\u003e--\u003e\r\n    \u003c!--\u003c/section\u003e--\u003e\r\n\r\n\u003cscript\u003e\r\nfunction switchImage(imagePath) {\r\n  const img = document.getElementById(\"servicePreview\");\r\n  img.style.opacity = \"0\";\r\n  setTimeout(() =\u003e {\r\n    img.src = imagePath;\r\n    img.style.opacity = \"1\";\r\n  }, 200);\r\n}\r\n\u003c/script\u003e\r\n\r\n\r\n    \u003c!-- Service end --\u003e\r\n\r\n    \u003csection class=\"content\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row text-center\"\u003e\r\n          \u003cdiv class=\"col-12\"\u003e\r\n           \u003ch2 class=\"section-sub-title\" style='   font-weight: 700;\r\n    font-size: 30px;\r\n    line-height: 1.3;\r\n    margin: 0 0 30px;\r\n    color: #212121;'\u003eOUR CLIENTS\u003c/h2\u003e\r\n\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n\r\n            \u003cdiv class=\"logo-slider\"\u003e\r\n   \u003cdiv class=\"logo-track\"\u003e\r\n\r\n      \u003c!-- COPY ALL YOUR LOGO ITEMS HERE INSIDE THIS TRACK --\u003e\r\n      \u003c!-- Duplicate the logos once more for smooth infinite loop --\u003e\r\n\r\n      \u003c!-- Your original 7 logos --\u003e\r\n      \u003cimg src=\"img/boschlogo.png\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/benelli-login-logo.jpg\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/okaya-new.jpg\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/river-index.jpg\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/Motohaus_logo.png\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/lectrix-new-logo.png\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/moto-vault-index.jpg\" class=\"client-logo\" style=\"width: 381px;\"/\u003e\r\n\r\n      \u003c!-- DUPLICATE SET (VERY IMPORTANT for smooth infinite loop) --\u003e\r\n      \u003cimg src=\"img/boschlogo.png\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/benelli-login-logo.jpg\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/okaya-new.jpg\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/river-index.jpg\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/Motohaus_logo.png\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/lectrix-new-logo.png\" class=\"client-logo\" /\u003e\r\n      \u003cimg src=\"img/moto-vault-index.jpg\" class=\"client-logo\" /\u003e\r\n\r\n   \u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n            \u003c!-- Clients row end --\u003e\r\n          \u003c/div\u003e\r\n          \u003c!-- Col end --\u003e\r\n  \r\n        \u003c!--/ Content row end --\u003e\r\n      \r\n      \u003c!--/ Container end --\u003e\r\n    \u003c/section\u003e\r\n    \u003c!-- Content end --\u003e\r\n\r\n    \u003c!--/ subscribe end --\u003e\r\n\r\n    \u003c!-- Testimonial End --\u003e\r\n\r\n    \u003cfooter class=\"footer\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch1 class=\"footer-logo\"\u003e\r\n              \u003cimg src=\"./img/EW-Logo 4.png\" alt=\"Logo\" /\u003e\r\n            \u003c/h1\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\r\n              Our extended warranty plans safeguard the products you rely on\r\n              every day—keeping them running smoothly and extending their\r\n              lifespan. From mobility to home essentials, we’ve got you covered.\r\n            \u003c/p\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003eAddress\u003c/h5\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\r\n              \u003ci class=\"fa fa-map-marker-alt me-3\"\u003e\u003c/i\u003eExtended Warranty India\r\n              Private Limited 215, First Floor, DLF South Court Mall, Saket, New\r\n              Delhi, 110017\r\n            \u003c/p\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-phone-alt me-3\"\u003e\u003c/i\u003e+011 49880000\u003c/p\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-envelope me-3\"\u003e\u003c/i\u003econtact@warrantyindia.co.in\u003c/p\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size:18px;font-family: Poppins;\"\u003e\r\n              Quick Links\r\n            \u003c/h5\u003e\r\n            \u003cul class=\"list-unstyled\" \u003e\r\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"about.html\" style=\"font-family: Poppins;font-size:14px\"\u003eAbout Us\u003c/a\u003e\u003c/li\u003e\r\n              \u003cli\u003e\r\n                \u003ca class=\"btn btn-link\" href=\"contact.html\" style=\"font-family: Poppins;font-size:14px\"\u003eContact Us\u003c/a\u003e\r\n              \u003c/li\u003e\r\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"terms-and-conditions.html\" style=\"font-family: Poppins;font-size:14px\"\u003eTerms \u0026 Conditions\u003c/a\u003e\u003c/li\u003e\r\n              \u003cli\u003e\r\n                \u003ca class=\"btn btn-link\" href=\"privacy-policy.html\" style=\"font-family: Poppins;font-size:14px\"\u003ePrivacy Policy\u003c/a\u003e\r\n              \u003c/li\u003e\r\n            \u003c/ul\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003e\r\n              OUR SERVICES\r\n            \u003c/h5\u003e\r\n           \u003cstyle\u003e\r\n  .btn-link {\r\n    display: block;\r\n  }\r\n  .list-unstyled .btn-link {\r\n    white-space: nowrap;\r\n    font-family: Poppins;\r\n    font-size:14px;\r\n  }/* Remove underline from footer links */\r\n.footer a.btn-link {\r\n    text-decoration: none !important;\r\n}\r\n\r\n/* Also remove underline on hover */\r\n.footer a.btn-link:hover {\r\n    text-decoration: none !important;\r\n}\r\n/* ===== FOOTER LEFT ALIGN FIX ===== */\r\n.footer,\r\n.footer * {\r\n  text-align: left !important;\r\n}\r\n\r\n/* Footer links */\r\n.footer .btn-link {\r\n  text-align: left !important;\r\n  padding-left: 0;\r\n}\r\n\r\n/* Remove center alignment added earlier */\r\n.footer .btn-link {\r\n  display: inline-block;\r\n}\r\n\r\n/* Footer columns spacing */\r\n.footer .col-md-3,\r\n.footer .col-md-6 {\r\n  text-align: left !important;\r\n}\r\n\r\n/* Footer logo alignment */\r\n.footer-logo img {\r\n  display: block;\r\n  margin-left: 0;\r\n}\r\n\r\n/* Footer bottom text */\r\n.footer-bottom {\r\n  text-align: left;\r\n}\r\n\r\n\u003c/style\u003e\r\n\r\n\u003cul class=\"list-unstyled\"\u003e\r\n  \u003cli \u003e\r\n    \u003ca class=\"btn btn-link\" href=\"https://truepromise.co.in/warranty/\"\u003eAutomobiles Warranty\u003c/a\u003e\r\n  \u003c/li\u003e\r\n  \r\n  \u003cli\u003e\r\n    \u003ca class=\"btn btn-link\" href=\"#\"\u003eElectronics \u0026 Home Appliances\u003c/a\u003e\r\n  \u003c/li\u003e\r\n\u003c/ul\u003e\r\n\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"footer-bottom\"\u003e\r\n          \u003cdiv class=\"col-md-6 text-md-start mb-3 mb-md-0\"\u003e\r\n            © \u003ca style=\"color: #007bff;font-family: Poppins;font-size:14px\"\u003eExtended Warranty\u003c/a\u003e, All\r\n            Right Reserved.\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/footer\u003e\r\n\r\n    \u003c!-- Back to Top --\u003e\r\n\u003ca href=\"#\" class=\"btn btn-lg btn-primary btn-lg-square back-to-top\" style=\"background-color: #110F3A; display: flex; justify-content: center; align-items: center; padding: 0;\"\u003e\r\n      \u003ci class=\"bi bi-arrow-up\" style=\"font-size: 25px;\"\u003e\u003c/i\u003e\r\n    \u003c/a\u003e\r\n    \r\n    \u003c!-- ============== CHATBOT HTML ============== --\u003e\r\n    \u003cdiv id=\"ewChatButton\"\u003e\r\n      \u003ci class=\"fa-solid fa-comments\"\u003e\u003c/i\u003e\r\n      \u003cspan style=\"font-family: 'Poppins', sans-serif !important;\"\u003eChat with us\u003c/span\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cdiv id=\"ewChatWindow\"\u003e\r\n      \u003cdiv id=\"ewChatHeader\"\u003e\r\n        \u003cdiv style=\"font-family: 'Poppins', sans-serif !important;\"\u003e\r\n          Extended Warranty Assistant\r\n          \u003cbr /\u003e\r\n          \u003csmall style=\"font-family: 'Poppins', sans-serif !important;\"\u003eAsk about coverage, claims, or plans\u003c/small\u003e\r\n        \u003c/div\u003e\r\n        \u003cspan style=\"cursor: pointer\" onclick=\"toggleEwChat()\"\u003e✕\u003c/span\u003e\r\n      \u003c/div\u003e\r\n      \u003cdiv id=\"ewChatMessages\" style\"font-family: 'Poppins', sans-serif !important;\"\u003e\u003c/div\u003e\r\n      \u003cdiv id=\"ewChatInputArea\" style\"font-family: 'Poppins', sans-serif !important;\"\u003e\r\n        \u003cinput\r\n          type=\"text\"\r\n          id=\"ewChatInput\"\r\n          placeholder=\"Type your question...\"\r\n        /\u003e\r\n        \u003cbutton id=\"ewChatSend\"\u003eSend\u003c/button\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n    \u003c!-- ============ END CHATBOT HTML ============ --\u003e\r\n\r\n\u003cscript\u003e\r\n  const clientRow = document.querySelector(\".all-clients\");\r\n\r\n  if (!clientRow.dataset.cloned) {\r\n    clientRow.dataset.cloned = \"true\";\r\n    clientRow.innerHTML += clientRow.innerHTML;\r\n  }\r\n\u003c/script\u003e\r\n\r\n\r\n    \u003cscript\u003e\r\n      window.addEventListener('scroll', function() {\r\n        const navbar = document.querySelector('.navbar');\r\n        if (window.scrollY \u003e 0) { // If the page is scrolled down\r\n          navbar.classList.add('scrolled');\r\n        } else { // When the page is at the top\r\n          navbar.classList.remove('scrolled');\r\n        }\r\n      });\r\n\r\ndocument.addEventListener(\"DOMContentLoaded\", function () {\r\n    const counters = document.querySelectorAll(\".counterUp\");\r\n\r\n    function animateToTarget(counters, callback) {\r\n        let allCompleted = 0; \r\n\r\n        counters.forEach(counter =\u003e {\r\n            let count = parseInt(counter.getAttribute(\"data-start\"), 10) || 0;\r\n            const target = parseInt(counter.getAttribute(\"data-count\"), 10) || 0;\r\n            counter.innerText = count;\r\n\r\n            const initialInterval = setInterval(() =\u003e {\r\n                if (count \u003c target) {\r\n                    count++;\r\n                    counter.innerText = count;\r\n                } else {\r\n                    clearInterval(initialInterval);\r\n                    allCompleted++; \r\n                    if (allCompleted === counters.length) {\r\n                        callback(); \r\n                    }\r\n                }\r\n            }, 50);\r\n        });\r\n    }\r\n\r\n    function startContinuousCounting(counters) {\r\n        let interval = setInterval(() =\u003e {\r\n            let allReached = true;\r\n\r\n            counters.forEach(counter =\u003e {\r\n                let count = parseInt(counter.innerText, 10);\r\n                const specificNumber = parseInt(counter.getAttribute(\"data-specific-number\"), 10) || 0;\r\n                const resetCount = parseInt(counter.getAttribute(\"data-count\"), 10) || 0;\r\n\r\n                if (count \u003c specificNumber) {\r\n                    allReached = false; // If any number is not reached, continue\r\n                }\r\n            });\r\n\r\n            if (!allReached) {\r\n                counters.forEach(counter =\u003e {\r\n                    let count = parseInt(counter.innerText, 10);\r\n                    const specificNumber = parseInt(counter.getAttribute(\"data-specific-number\"), 10) || 0;\r\n\r\n                    if (count \u003c specificNumber) {\r\n                        counter.innerText = count + 1;\r\n                    }\r\n                });\r\n            } else {\r\n                clearInterval(interval);\r\n                setTimeout(() =\u003e animateToTarget(counters, () =\u003e startContinuousCounting(counters)), 1000); // Restart loop after 1s delay\r\n            }\r\n        }, 7000); // Now increasing every 7 seconds\r\n    }\r\n\r\n    // Start the animation\r\n    animateToTarget(counters, () =\u003e startContinuousCounting(counters));\r\n});\r\n\r\n\r\n\r\n    // Scroll event to do nothing - just let the interval run\r\n    window.addEventListener('scroll', function() {\r\n        // No reinitialization or reset - counting continues\r\n    });\r\n\r\n    \r\n    \u003c/script\u003e\r\n    \r\n   \r\n\r\n    \r\n    \u003c!-- JavaScript Libraries --\u003e\r\n\u003cscript src=\"https://code.jquery.com/jquery-3.4.1.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"lib/wow/wow.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"lib/easing/easing.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"lib/waypoints/waypoints.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"lib/owlcarousel/owl.carousel.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"lib/counterup/counterup.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"https://code.jquery.com/jquery-3.6.0.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js\"\u003e\u003c/script\u003e\r\n\r\n\u003c!-- Template Javascript --\u003e\r\n\u003cscript src=\"js/main.js\"\u003e\u003c/script\u003e\r\n\r\n\u003c!-- Slick Carousel (if used) --\u003e\r\n\u003cscript src=\"plugins/slick/slick.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript src=\"plugins/slick/slick-animation.min.js\"\u003e\u003c/script\u003e\r\n\r\n\u003c!-- Color box (if used) --\u003e\r\n\u003cscript src=\"plugins/colorbox/jquery.colorbox.js\"\u003e\u003c/script\u003e\r\n\r\n\u003c!-- shuffle (if used) --\u003e\r\n\u003cscript src=\"plugins/shuffle/shuffle.min.js\" defer\u003e\u003c/script\u003e\r\n\r\n\u003c!-- Google Map (if used) --\u003e\r\n\u003cscript src=\"https://maps.googleapis.com/maps/api/js?key=AIzaSyCcABaamniA6OL5YvYSpB3pFMNrXwXnLwU\" defer\u003e\u003c/script\u003e\r\n\u003cscript src=\"plugins/google-map/map.js\" defer\u003e\u003c/script\u003e\r\n\r\n\u003c!-- Template custom --\u003e\r\n\u003cscript src=\"js2/script.js\"\u003e\u003c/script\u003e\r\n\r\n  \u003c!-- ============== CHATBOT SCRIPT ============== --\u003e\r\n    \u003cscript\u003e\r\n      const ewBtn = document.getElementById(\"ewChatButton\");\r\n      const ewWin = document.getElementById(\"ewChatWindow\");\r\n      const ewMsgBox = document.getElementById(\"ewChatMessages\");\r\n      const ewInput = document.getElementById(\"ewChatInput\");\r\n      const ewSendBtn = document.getElementById(\"ewChatSend\");\r\n\r\n      function toggleEwChat() {\r\n        if (ewWin.style.display === \"flex\") {\r\n          ewWin.style.display = \"none\";\r\n        } else {\r\n          ewWin.style.display = \"flex\";\r\n          if (!ewMsgBox.dataset.welcomed) {\r\n            // Only greeting text here, options will come from PHP after \"hi\"\r\n            addBotMsg(\r\n  \"Hello 👋 I’m your Extended Warranty Assistant.\\n\"\r\n  + \"To get started, please share your details in *one message* like this:\\n\\n\"\r\n  + \"Rahul Kumar, 9811111111, rahul@gmail.com, Delhi\",\r\n  []\r\n);\r\n            ewMsgBox.dataset.welcomed = \"1\";\r\n          }\r\n        }\r\n      }\r\n\r\n      //ewBtn.addEventListener(\"click\", toggleEwChat);\r\n\r\n      function addBotMsg(text, options = []) {\r\n        const wrap = document.createElement(\"div\");\r\n        wrap.className = \"ew-msg\";\r\n\r\n        const bubble = document.createElement(\"div\");\r\n        bubble.className = \"ew-bot\";\r\n        bubble.innerHTML = text.replace(/\\n/g, \"\u003cbr\u003e\");\r\n        wrap.appendChild(bubble);\r\n\r\n        // If options are provided, render buttons\r\n        if (options \u0026\u0026 options.length) {\r\n          const btnWrap = document.createElement(\"div\");\r\n          btnWrap.style.marginTop = \"6px\";\r\n\r\n          options.forEach((opt) =\u003e {\r\n            const btn = document.createElement(\"button\");\r\n            btn.className = \"ew-option-btn\";\r\n            btn.textContent = opt.label;\r\n            btn.addEventListener(\"click\", () =\u003e handleEwOptionClick(opt));\r\n            btnWrap.appendChild(btn);\r\n          });\r\n\r\n          bubble.appendChild(btnWrap);\r\n        }\r\n\r\n        ewMsgBox.appendChild(wrap);\r\n        ewMsgBox.scrollTop = ewMsgBox.scrollHeight;\r\n      }\r\n\r\n      function addUserMsg(text) {\r\n        const div = document.createElement(\"div\");\r\n        div.className = \"ew-msg\";\r\n        div.innerHTML =\r\n          '\u003cdiv class=\"ew-user\"\u003e' + text.replace(/\\n/g, \"\u003cbr\u003e\") + \"\u003c/div\u003e\";\r\n        ewMsgBox.appendChild(div);\r\n        ewMsgBox.scrollTop = ewMsgBox.scrollHeight;\r\n      }\r\n\r\n      async function sendEwMessage() {\r\n        const text = ewInput.value.trim();\r\n        if (!text) return;\r\n        addUserMsg(text);\r\n        ewInput.value = \"\";\r\n\r\n        try {\r\n          const res = await fetch(\"chat-bot.php\", {\r\n            method: \"POST\",\r\n            headers: { \"Content-Type\": \"application/json\" },\r\n            body: JSON.stringify({ message: text })\r\n          });\r\n\r\n          const data = await res.json();\r\n          addBotMsg(\r\n            data.reply ||\r\n              \"Sorry, I couldn't understand. Our team will contact you shortly.\",\r\n            data.options || []\r\n          );\r\n        } catch (e) {\r\n          console.error(e);\r\n          addBotMsg(\r\n            \"Technical issue from our side. Please try again or call our support team.\",\r\n            []\r\n          );\r\n        }\r\n      }\r\n\r\n      // When user clicks an option button\r\n      async function handleEwOptionClick(opt) {\r\n        // Show selected option as user message\r\n        addUserMsg(opt.label);\r\n\r\n        try {\r\n          const res = await fetch(\"chat-bot.php\", {\r\n            method: \"POST\",\r\n            headers: { \"Content-Type\": \"application/json\" },\r\n            body: JSON.stringify({ option: opt.id })\r\n          });\r\n\r\n          const data = await res.json();\r\n          addBotMsg(\r\n            data.reply ||\r\n              \"Sorry, I couldn't find details for this option.\",\r\n            data.options || []\r\n          );\r\n        } catch (e) {\r\n          console.error(e);\r\n          addBotMsg(\r\n            \"Technical issue from our side. Please try again or call our support team.\",\r\n            []\r\n          );\r\n        }\r\n      }\r\n\r\n      ewSendBtn.addEventListener(\"click\", sendEwMessage);\r\n      ewInput.addEventListener(\"keypress\", function (e) {\r\n        if (e.key === \"Enter\") {\r\n          e.preventDefault();\r\n          sendEwMessage();\r\n        }\r\n      });\r\n    \u003c/script\u003e\r\n    \u003c!-- ============ END CHATBOT SCRIPT ============ --\u003e\r\n    \r\n    \u003cscript\u003e\r\n  /* ===============================\r\n     WHATSAPP CONFIG\r\n     =============================== */\r\n  const WA_NUMBER = \"919821760165\"; // ✅ TEST NUMBER\r\n  const WA_MSG =\r\n`Hello 👋 I’m your Extended Warranty Assistant.\r\nMay I help you? To get started, please type your *Name* in the box below.`;\r\n\r\n  function isMobileDevice() {\r\n    return window.matchMedia(\"(max-width: 991px)\").matches;\r\n  }\r\n\r\n  function openWhatsAppChat() {\r\n    const waUrl =\r\n      \"https://wa.me/\" + WA_NUMBER + \"?text=\" + encodeURIComponent(WA_MSG);\r\n    window.open(waUrl, \"_blank\");\r\n  }\r\n\r\n  document.addEventListener(\"DOMContentLoaded\", function () {\r\n    const chatBtn = document.getElementById(\"ewChatButton\");\r\n    if (!chatBtn) return;\r\n\r\n    chatBtn.style.display = \"flex\";\r\n\r\n    chatBtn.addEventListener(\"click\", function (e) {\r\n      e.preventDefault();\r\n\r\n      if (isMobileDevice()) {\r\n        // ✅ MOBILE → WhatsApp\r\n        openWhatsAppChat();\r\n      } else {\r\n        // ✅ DESKTOP → Website chatbot\r\n        toggleEwChat();\r\n      }\r\n    });\r\n  });\r\n\u003c/script\u003e\r\n\r\n\r\n\r\n  \u003c/body\u003e\r\n\u003c/html\u003e\r\n","content_type":"text/html","method":"GET","host":"warrantyindia.com","host_ip":"101.53.149.53","path":"/index.html","header":{"accept_ranges":"bytes","content_length":"58587","content_type":"text/html","date":"Fri, 18 Sep 2026 14:54:15 GMT","last_modified":"Tue, 30 Dec 2025 06:19:19 GMT","server":"Apache"},"raw_header":"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 58587\r\nAccept-Ranges: bytes\r\nContent-Type: text/html\r\nDate: Fri, 18 Sep 2026 14:54:15 GMT\r\nLast-Modified: Tue, 30 Dec 2025 06:19:19 GMT\r\nServer: Apache\r\n\r\n","request":"GET /index.html HTTP/1.1\r\nHost: warrantyindia.com\r\nUser-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 10_14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/14.1.2 Safari/605.1.15\r\nAccept-Charset: utf-8\r\nAccept-Encoding: gzip\r\n\r\n","time":"660.4519ms","a":["101.53.149.53"],"tech":["Apache HTTP Server","Bootstrap:5.0.0","BootstrapCDN:4.5.2","Cloudflare","Font Awesome","Google Maps","OWL Carousel","Popper:1.16.0","Slick","WOW","cdnjs","jQuery CDN","jQuery:3.4.1","jsDelivr"],"words":14472,"lines":1759,"status_code":200,"content_length":58587,"failed":false,"knowledgebase":{"PageType":"landing","pHash":0},"resolvers":["[2409:40d0:250b:70b2::de]:53","1.1.1.1:53"]}
