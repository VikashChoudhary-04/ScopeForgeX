16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eAbout Us\u003c/a\u003e\r\n\r\n          \u003cdiv class=\"nav-item dropdown\"\u003e\r\n            \u003c!--\u003ca href=\"service.html\" data-bs-toggle=\"dropdown\" class=\"nav-link active\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eOur OFFERINGS\u003c/a\u003e--\u003e\r\n            \u003cdiv class=\"dropdown-menu custom-dropdown\"\u003e\r\n \r\n  \u003ca href=\"https://truepromise.co.in/warranty/\" class=\"dropdown-item\" style=\"font-weight:600;font-family: Poppins;\"\u003eAutomobiles Warranty\u003c/a\u003e\r\n   \u003c!--\u003ca href=\"2W.html\" class=\"dropdown-item\"\u003eTwo Wheeler Warranty\u003c/a\u003e--\u003e\r\n  \u003ca href=\"https://extracare.co.in/ExtraCare/assimox-html-package/assimox-html-main/index.html\" class=\"dropdown-item\" style=\"font-weight:600;font-family: Poppins;\"\u003eConsumer Durables Warranty\u003c/a\u003e\r\n\u003c/div\u003e\r\n          \u003c/div\u003e\r\n \u003ca href=\"partnerwithuse.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003e Partner With Us \u003c/a\u003e\r\n          \u003ca href=\"contact.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eContact Us\u003c/a\u003e\r\n\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- \u003cdiv class=\"buttonforhidden\"\u003e\r\n        \u003cbutton style=\"border-radius: 12px;color: white; backdrop-filter: blur(1px);\r\n    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1) ; padding: 5px 10px 5px \r\n    10px ; \"\u003e Login \u003c/button\u003e \r\n        \u003cbutton style=\"background-color: #2d286b; color: white; border: 2px solid #2d286b; border-radius: 3px; padding: 5px 10px 5px 10px;\"\u003e Sign up \u003c/button\u003e\r\n      \u003c/div\u003e --\u003e\r\n    \r\n    \u003c/nav\u003e\r\n\r\n    \u003c!-- Navbar End --\u003e\r\n\r\n    \u003c!-- Carousel Start --\u003e\r\n\r\n\u003csection class=\"hero\"\u003e\r\n\r\n  \u003c!-- TOP TEXT --\u003e\r\n  \u003cdiv class=\"hero-top\"\u003e\r\n    \u003ch1\u003e\r\n      YOUR PEACE OF MIND \u003cbr\u003e\r\n      OUR PROMISE\r\n    \u003c/h1\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003c!-- MIDDLE = IMAGE ONLY (NO TEXT HERE) --\u003e\r\n  \u003cdiv class=\"hero-middle\"\u003e\u003c/div\u003e\r\n\r\n  \u003c!-- BOTTOM TEXT --\u003e\r\n  \u003cdiv class=\"hero-bottom\"\u003e\r\n    India’s Most Trusted Extended Warranty for Cars, Bikes \u0026 Home Appliances\u003cbr\u003e\r\n    *Pan India Presence • Genuine Parts • Hassle Free Claims\r\n  \u003c/div\u003e\r\n\r\n\u003c/section\u003e\r\n\r\n\r\n\r\n\r\n    \u003csection id=\"ts-features\" class=\"ts-features py-5\" style = 'margin-top:20px;'\u003e\r\n  \u003cdiv class=\"container\"\u003e\r\n    \u003cdiv class=\"row align-items-center\"\u003e\r\n      \r\n      \u003c!-- Left Column - Main Heading \u0026 Description --\u003e\r\n      \u003cdiv class=\"col-lg-5 mb-5 mb-lg-0 ts-left-col\"\u003e\r\n        \u003cdiv class=\"pe-lg-4\"\u003e\r\n          \u003ch1 class=\"fw-bold mb-4\" style=\"color: #212121; line-height: 1.35; font-weight:700;font-size: 30px;text-transform:uppercase;\"\u003e\r\n          Your Assets Our Assurance\r\n \r\n          \u003c/h1\u003e\r\n          \u003cp class=\"text-muted mb-5\" style=\"line-height: 1.7;color:#3b3b3b!important;text-align:justify;font-family: Poppins;\"\u003e\r\n           At Extended Warranty India, we provide comprehensive warranty solutions for Automobiles, Home Appliances, Electronics, IT Hardware, and Construction Equipment. With extensive industry expertise, we aim to deliver worry-free ownership by shielding ours customers from unforeseen expenses caused by sudden failures or repairs.\r\n          \u003c/p\u003e\r\n          \r\n          \u003c!-- Trust Badges in Grid --\u003e\r\n         \u003cdiv class=\"row g-3 trust-badges\"\u003e\r\n  \u003cdiv class=\"col-6\"\u003e\r\n    \u003cdiv class=\"d-flex align-items-center\"\u003e\r\n      \u003cdiv class=\"me-3\"\u003e\r\n        \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\"\r\n             style=\"width: 48px; height: 48px; background: #f0f4ff;\"\u003e\r\n          \u003ci class=\"fas fa-trophy\" style=\"color: #2d286b; font-size: 30px;\"\u003e\u003c/i\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003ch6 class=\"mb-0 fw-semibold\" style=\"font-size: 16px; color: #333;\"\u003e\r\n        Excellence Delivered\r\n      \u003c/h6\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003cdiv class=\"col-6\"\u003e\r\n    \u003cdiv class=\"d-flex align-items-center\"\u003e\r\n      \u003cdiv class=\"me-3\"\u003e\r\n        \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\"\r\n             style=\"width: 48px; height: 48px; background: #f0f4ff;\"\u003e\r\n          \u003ci class=\"fas fa-handshake\" style=\"color:#2d286b; font-size: 30px;\"\u003e\u003c/i\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003ch6 class=\"mb-0 fw-semibold\" style=\"font-size: 16px; color: #333;\"\u003e\r\n        Driven by Commitment\r\n      \u003c/h6\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003cdiv class=\"col-6 mt-3\"\u003e\r\n    \u003cdiv class=\"d-flex align-items-center\"\u003e\r\n      \u003cdiv class=\"me-3\"\u003e\r\n        \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\"\r\n             style=\"width: 48px; height: 48px; background: #f0f4ff;\"\u003e\r\n          \u003ci class=\"fas fa-heart\" style=\"color: #2d286b; font-size: 30px;\"\u003e\u003c/i\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003ch6 class=\"mb-0 fw-semibold\" style=\"font-size: 16px; color: #333;\"\u003e\r\n        Built on Trust\r\n \r\n      \u003c/h6\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003cdiv class=\"col-6 mt-3\"\u003e\r\n    \u003cdiv class=\"d-flex align-items-center\"\u003e\r\n      \u003cdiv class=\"me-3\"\u003e\r\n        \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\"\r\n             style=\"width: 48px; height: 48px; background: #f0f4ff;\"\u003e\r\n          \u003ci class=\"fas fa-user-tie\" style=\"color: #2d286b; font-size: 30px;\"\u003e\u003c/i\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003ch6 class=\"mb-0 fw-semibold\" style=\"font-size: 16px; color: #333;\"\u003e\r\n        Backed by Experts\r\n      \u003c/h6\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \r\n      \u003c!-- Middle Column Divider --\u003e\r\n      \u003cdiv class=\"col-lg-1 d-none d-lg-block\"\u003e\r\n        \u003cdiv class=\"h-100 d-flex justify-content-center\"\u003e\r\n          \u003cdiv style=\"width: 1px; background: linear-gradient(to bottom, transparent, #e2e8ff, #e2e8ff, transparent);\"\u003e\u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \r\n      \u003c!-- Right Column - Features --\u003e\r\n      \u003cdiv class=\"col-lg-6\"\u003e\r\n        \u003cdiv class=\"ps-lg-5\" style=\"padding-left:0px !important;padding-right:30px !important\"\u003e\r\n          \u003c!--\u003cdiv class=\"mb-4\"\u003e--\u003e\r\n          \u003c!--  \u003cspan class=\"badge rounded-pill px-3 py-2 mb-3\" style=\"background: #2d286b; color: white; font-size: 0.8rem; letter-spacing: 1px;\"\u003e--\u003e\r\n          \u003c!--    WHAT DRIVES US--\u003e\r\n          \u003c!--  \u003c/span\u003e--\u003e\r\n          \u003c!--\u003c/div\u003e--\u003e\r\n          \r\n          \u003c!-- Feature Cards --\u003e\r\n          \u003cdiv class=\"row g-4\"\u003e\r\n            \u003cdiv class=\"col-md-12\"\u003e\r\n              \u003cdiv class=\"feature-card p-4 rounded-3 h-100\" style=\"border-left: 4px solid #2d286b; background: #f8f9ff;\"\u003e\r\n                \u003cdiv class=\"d-flex align-items-start\"\u003e\r\n                  \u003cdiv class=\"me-3\"\u003e\r\n                    \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\" style=\"width: 48px; height: 48px; background: white; border: 2px solid #4a3aff;\"\u003e\r\n                      \u003ci class=\"fas fa-shield-alt\" style=\"color:#2d286b; font-size: 1.2rem;\"\u003e\u003c/i\u003e\r\n                    \u003c/div\u003e\r\n                  \u003c/div\u003e\r\n                  \u003cdiv\u003e\r\n                    \u003ch4 class=\"fw-bold mb-2\" style=\"color: #212121; font-size: 1.1rem;\"\u003e\r\n                      UNCOMPROMISING SAFETY\r\n \r\n                    \u003c/h4\u003e\r\n                    \u003cp class=\"mb-0 text-muted\" style=\"font-size: 0.9rem; line-height: 1.6;color:#3b3b3b!important;font-weight:600;font-family: Poppins;\"\u003e\r\n                     Shielding you from costly, unexpected repairs.\r\n                    \u003c/p\u003e\r\n                  \u003c/div\u003e\r\n                \u003c/div\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cdiv class=\"col-md-12\"\u003e\r\n              \u003cdiv class=\"feature-card p-4 rounded-3 h-100\" style=\"border-left: 4px solid #00b894; background: #f0fffa;\"\u003e\r\n                \u003cdiv class=\"d-flex align-items-start\"\u003e\r\n                  \u003cdiv class=\"me-3\"\u003e\r\n                    \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\" style=\"width: 48px; height: 48px; background: white; border: 2px solid #00b894;\"\u003e\r\n                      \u003ci class=\"fas fa-headset\" style=\"color: #00b894; font-size: 1.2rem;\"\u003e\u003c/i\u003e\r\n                    \u003c/div\u003e\r\n                  \u003c/div\u003e\r\n                  \u003cdiv\u003e\r\n                    \u003ch4 class=\"fw-bold mb-2\" style=\"color: #212121; font-size: 1.1rem;\"\u003e\r\n                      24/7 CUSTOMER SUPPORT\r\n                    \u003c/h4\u003e\r\n                    \u003cp class=\"mb-0 text-muted\" style=\"font-size: 0.9rem; line-height: 1.6;color:#3b3b3b!important;font-weight:600;font-family: Poppins;\"\u003e\r\n                      Fast, friendly support whenever you need it — claims made simple.\r\n                    \u003c/p\u003e\r\n                  \u003c/div\u003e\r\n                \u003c/div\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003cdiv class=\"col-md-12\"\u003e\r\n              \u003cdiv class=\"feature-card p-4 rounded-3 h-100\" style=\"border-left: 4px solid #ff9f43; background: #fff9f0;\"\u003e\r\n                \u003cdiv class=\"d-flex align-items-start\"\u003e\r\n                  \u003cdiv class=\"me-3\"\u003e\r\n                    \u003cdiv class=\"rounded-circle d-flex align-items-center justify-content-center\" style=\"width: 48px; height: 48px; background: white; border: 2px solid #ff9f43;\"\u003e\r\n                      \u003ci class=\"fas fa-award\" style=\"color: #ff9f43; font-size: 1.2rem;\"\u003e\u003c/i\u003e\r\n                    \u003c/div\u003e\r\n                  \u003c/div\u003e\r\n                  \u003cdiv\u003e\r\n                    \u003ch4 class=\"fw-bold mb-2\" style=\"color:#212121; font-size: 1.1rem;color:#3b3b3b!important;\"\u003e\r\n                      Trusted Nationwide\r\n                    \u003c/h4\u003e\r\n                    \u003cp class=\"mb-0 \" style=\"font-size: 0.9rem; line-height: 1.6;font-weight:600;font-family: Poppins;\"\u003e\r\n                     Clear coverage, rapid approvals, trusted performance.\r\n                    \u003c/p\u003e\r\n          