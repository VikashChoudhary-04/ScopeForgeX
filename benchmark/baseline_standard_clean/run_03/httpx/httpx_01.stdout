class=\"btn btn-link\" href=\"contact.html\" style=\"font-family: Poppins;font-size:14px\"\u003eContact Us\u003c/a\u003e\n              \u003c/li\u003e\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"terms-and-conditions.html\" style=\"font-family: Poppins;font-size:14px\"\u003eTerms \u0026 Conditions\u003c/a\u003e\u003c/li\u003e\n              \u003cli\u003e\n                \u003ca class=\"btn btn-link\" href=\"privacy-policy.html\" style=\"font-family: Poppins;font-size:14px\"\u003ePrivacy Policy\u003c/a\u003e\n              \u003c/li\u003e\n            \u003c/ul\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003e\n              OUR SERVICES\n            \u003c/h5\u003e\n           \u003cstyle\u003e\n  .btn-link {\n    display: block;\n    text-align: center;\n  }\n  .list-unstyled .btn-link {\n    white-space: nowrap;\n    font-family: Poppins;\n    font-size:14px;\n  }/* Remove underline from footer links */\n.footer a.btn-link {\n    text-decoration: none !important;\n}\n\n/* Also remove underline on hover */\n.footer a.btn-link:hover {\n    text-decoration: none !important;\n}\n\n\u003c/style\u003e\n\n\u003cul class=\"list-unstyled\"\u003e\n  \u003cli \u003e\n    \u003ca class=\"btn btn-link\" href=\"https://truepromise.co.in/warranty/\"\u003eAutomobiles Warranty\u003c/a\u003e\n  \u003c/li\u003e\n  \n  \u003cli\u003e\n    \u003ca class=\"btn btn-link\" href=\"https://extracare.co.in/ExtraCare/assimox-html-package/assimox-html-main/index.html\"\u003eElectronics \u0026 Home Appliances\u003c/a\u003e\n  \u003c/li\u003e\n\u003c/ul\u003e\n\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"footer-bottom\"\u003e\n          \u003cdiv class=\"col-md-6 text-md-start mb-3 mb-md-0\"\u003e\n            © \u003ca  style=\"color: #007bff;font-family: Poppins;font-size:14px\"\u003eExtended Warranty\u003c/a\u003e, All\n            Right Reserved.\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/footer\u003e\n\n  \u003c!-- Back to Top --\u003e\n\u003ca href=\"#\" class=\"btn btn-lg btn-primary btn-lg-square back-to-top\" style=\"background-color: #212121; display: flex; justify-content: center; align-items: center; padding: 0;\"\u003e\n      \u003ci class=\"bi bi-arrow-up\" style=\"font-size: 25px;\"\u003e\u003c/i\u003e\n    \u003c/a\u003e\n    \n    \u003cscript\u003e\n  function showdata() {\n    let elements = document.getElementsByClassName('buttonforhidden');\n    let elements1 = document.getElementsByClassName('navbar-expand-lg');\n\n            for (let i = 0; i \u003c elements.length; i++) {\n                if (elements[i].style.display === 'none' || elements[i].style.display === '') {\n                    elements[i].style.display = 'block';\n                    elements[i].style.margin = 'auto';\n                    elements1[i].style.background = 'black';\n                } else {\n                    elements[i].style.display = '';\n                    elements1[i].style.background = '';\n                    \n                }\n            }\n        }\n  \n\u003c/script\u003e\n  \u003c!-- JavaScript Libraries --\u003e\n  \u003cscript src=\"https://code.jquery.com/jquery-3.4.1.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"lib/wow/wow.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"lib/easing/easing.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"lib/waypoints/waypoints.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"lib/owlcarousel/owl.carousel.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"lib/counterup/counterup.min.js\"\u003e\u003c/script\u003e\n\n  \u003c!-- Template Javascript --\u003e\n  \u003cscript src=\"js/main.js\"\u003e\u003c/script\u003e\n\u003c/body\u003e\n\n\u003c/html\u003e","content_type":"text/html","method":"GET","host":"warrantyindia.com","host_ip":"101.53.149.53","path":"/terms-and-conditions.html","header":{"accept_ranges":"bytes","content_length":"27319","content_type":"text/html","date":"Fri, 18 Sep 2026 14:54:14 GMT","last_modified":"Wed, 10 Dec 2025 11:51:45 GMT","server":"Apache"},"raw_header":"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 27319\r\nAccept-Ranges: bytes\r\nContent-Type: text/html\r\nDate: Fri, 18 Sep 2026 14:54:14 GMT\r\nLast-Modified: Wed, 10 Dec 2025 11:51:45 GMT\r\nServer: Apache\r\n\r\n","request":"GET /terms-and-conditions.html HTTP/1.1\r\nHost: warrantyindia.com\r\nUser-Agent: Mozilla/5.0 (ZZ; Linux i686) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36\r\nAccept-Charset: utf-8\r\nAccept-Encoding: gzip\r\n\r\n","time":"462.184208ms","a":["101.53.149.53"],"tech":["Apache HTTP Server","Bootstrap:5.0.0","OWL Carousel","Unpkg","WOW","jQuery CDN","jQuery:3.4.1","jsDelivr"],"words":5842,"lines":524,"status_code":200,"content_length":27319,"failed":false,"knowledgebase":{"PageType":"soft_404","pHash":0},"resolvers":["[2409:40d0:250b:70b2::de]:53","1.1.1.1:53"]}
{"timestamp":"2026-09-18T10:54:14.524541489-04:00","port":"443","url":"https://warrantyindia.com/about.html","input":"https://warrantyindia.com/about.html","title":"About Us – Extended Warranty","scheme":"https","webserver":"Apache","body":"\u003c!DOCTYPE html\u003e\r\n\u003chtml lang=\"en\"\u003e\r\n\u003chead\u003e\r\n  \u003cmeta charset=\"utf-8\" /\u003e\r\n  \u003ctitle\u003eAbout Us – Extended Warranty\u003c/title\u003e\r\n  \u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\" /\u003e\r\n\r\n  \u003c!-- Google Web Fonts --\u003e\r\n  \u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\" /\u003e\r\n  \u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin /\u003e\r\n  \u003clink\r\n    href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500\u0026family=Poppins:wght@500;600;700\u0026display=swap\"\r\n    rel=\"stylesheet\"\r\n  /\u003e\r\n\r\n  \u003c!-- Bootstrap 5 --\u003e\r\n  \u003clink\r\n    href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\"\r\n    rel=\"stylesheet\"\r\n  /\u003e\r\n\r\n  \u003c!-- Font Awesome 6 --\u003e\r\n  \u003clink\r\n    rel=\"stylesheet\"\r\n    href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\r\n  /\u003e\r\n\r\n  \u003c!-- Custom About Page CSS --\u003e\r\n  \u003clink rel=\"stylesheet\" href=\"about2.css\" /\u003e\r\n  \u003clink href=\"css/bootstrap.min.css\" rel=\"stylesheet\" /\u003e\r\n\r\n  \u003c!-- Template Stylesheet --\u003e\r\n\r\n  \u003clink rel=\"stylesheet\" href=\"index.css\"\u003e\r\n  \u003clink rel=\"stylesheet\" href=\"2W.css\"\u003e\r\n\r\n  \r\n  \u003clink href=\"about.css\" rel=\"stylesheet\" /\u003e\r\n \r\n\r\n\r\n  \u003c!-- Template Stylesheet --\u003e\r\n  \u003clink href=\"css/style.css\" rel=\"stylesheet\" /\u003e\r\n  \u003cstyle\u003e\r\n\r\n    /* MOBILE: navbar background start se visible */\r\n@media (max-width: 991px){\r\n  .navbar{\r\n    background: rgba(17, 15, 58, 0.92) !important;  /* start */\r\n    backdrop-filter: blur(10px);\r\n    -webkit-backdrop-filter: blur(10px);\r\n  }\r\n\r\n  /* when scroll */\r\n  .navbar.scrolled{\r\n    background: rgba(17, 15, 58, 0.98) !important;\r\n  }\r\n\r\n  /* dropdown/collapse menu background */\r\n  .navbar-collapse{\r\n    background: rgba(17, 15, 58, 0.98) !important;\r\n    padding: 12px 14px;\r\n    border-radius: 12px;\r\n  }\r\n}\r\n      *{\r\n       font-family:Poppins;   \r\n      }\r\n      .about-hero .about-subtitle {\r\n    text-align: justify;\r\n    text-justify: inter-word;\r\n    max-width: 100%;           /* Allows full width justification */\r\n}\r\n\r\n.about-hero .container {\r\n    padding-left: 10px !important;\r\n    padding-right: 10px !important;\r\n}\r\n\r\n  \u003c/style\u003e\r\n\u003c/head\u003e\r\n\r\n\u003cbody\u003e\r\n\r\n  \u003c!-- ✅ YOUR NAVBAR (About set as active, Offerings normal) --\u003e\r\n  \u003cnav class=\"navbar navbar-expand-lg navbar-light sticky-top px-4 px-lg-5\" style=\"background:  url('./img/darkbg.jpg'); background-size: cover; background-position: center; height: 148px;\"\u003e\r\n\r\n      \u003ca href=\"index.html\" class=\"navbar-brand d-flex flex-column align-items-start\"\u003e\r\n  \u003ch1 class=\"m-0\"\u003e\r\n    \u003cimg class=\"img-fluid me-3\"\r\n         src=\"img/EW-Logo 4.png\"\r\n         alt=\"\"\r\n         style=\"max-height: 70px; width: 125px;\" /\u003e\r\n  \u003c/h1\u003e\r\n  \u003ch6 class=\"m-0 text-white fw-normal\"\u003eYour Ultimate Warranty Partner\u003c/h6\u003e\r\n\u003c/a\u003e\r\n\r\n\r\n     \u003cbutton type=\"button\" onclick=\"showdata()\" class=\"navbar-toggler\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarCollapse\" aria-expanded=\"true\"\u003e\r\n        \u003cspan class=\"navbar-toggler-icon\"\u003e\u003c/span\u003e\r\n      \u003c/button\u003e\r\n      \r\n\r\n      \u003cdiv class=\"collapse navbar-collapse\" id=\"navbarCollapse\"\u003e\r\n\r\n        \u003cdiv class=\"navbar-nav rounded pe-4 py-3 py-lg-0\" style=\"margin-left: auto; gap: 20px\"\u003e\r\n              \u003ca href=\"index.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eHOME\u003c/a\u003e\r\n          \u003ca href=\"about.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eAbout Us\u003c/a\u003e\r\n\r\n          \u003cdiv class=\"nav-item dropdown\"\u003e\r\n            \u003c!--\u003ca href=\"service.html\" data-bs-toggle=\"dropdown\" class=\"nav-link active\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eOur OFFERINGS\u003c/a\u003e--\u003e\r\n            \u003cdiv class=\"dropdown-menu custom-dropdown\"\u003e\r\n \r\n  \u003ca href=\"https://truepromise.co.in/warranty/\" class=\"dropdown-item\"\u003eAutomobile Warranty\u003c/a\u003e\r\n   \u003c!--\u003ca href=\"2W.html\" class=\"dropdown-item\"\u003eTwo Wheeler Warranty\u003c/a\u003e--\u003e\r\n  \u003ca href=\"#\" class=\"dropdown-item\"\u003eConsumer Durables Warranty\u003c/a\u003e\r\n\u003c/div\u003e\r\n          \u003c/div\u003e\r\n \u003ca href=\"partnerwithuse.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003e Partner With Us \u003c/a\u003e\r\n          \u003ca href=\"contact.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eContact Us\u003c/a\u003e\r\n\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- \u003cdiv class=\"buttonforhidden\"\u003e\r\n        \u003cbutton style=\"border-radius: 12px;color: white; backdrop-filter: blur(1px);\r\n    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1) ; padding: 5px 10px 5px \r\n    10px ; \"\u003e Login \u003c/button\u003e \r\n        \u003cbutton style=\"background-color: #2d286b; color: white; border: 2px solid #2d286b; border-radius: 3px; padding: 5px 10px 5px 10px;\"\u003e Sign up \u003c/button\u003e\r\n      \u003c/div\u003e --\u003e\r\n    \r\n    \u003c/nav\u003e\r\n\r\n  \u003c!-- ABOUT PAGE MAIN WRAPPER --\u003e\r\n  \u003cmain id=\"about-page\"\u003e\r\n\r\n\r\n    \u003csection class=\"about-hero text-white\" style=\"background:white\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row align-items-center gy-4\"\u003e\r\n          \u003cdiv class=\"col-lg-12\"\u003e\r\n            \u003cspan class=\"section-tag\" style=\"font-size:16px; color:#2d286b\"\u003eAbout us\u003c/span\u003e\r\n            \u003ch1 class=\"about-title\" style=\"color:black; font-weight:700\"\u003e\r\n              Building India’s Most Trusted Warranty Ecosystem\r\n            \u003c/h1\u003e\r\n            \u003cp class=\"about-subtitle\" style=\"color:black\"\u003e\r\n             We are India’s largest Warranty Management Solutions provider, we are transforming the way businesses manage post-sales experiences. With a robust network of more than 1,000 after-sales service points across the country, we ensure seamless support and superior customer experience. Our presence spans 28+ regional offices throughout India, enabling us to deliver prompt and reliable service nationwide. Headquartered in Saket, New Delhi, we are committed to offering comprehensive warranty solutions that safeguard valuable assets and provide long-term peace of mind to our customers.\r\n            \u003c/p\u003e\r\n\r\n            \u003cdiv class=\"d-flex flex-wrap align-items-center gap-3 mt-4\"\u003e\r\n              \u003cdiv class=\"about-badge\" style=\"color:black\"\u003e\r\n                \u003ci class=\"fa-solid fa-star me-2\"\u003e\u003c/i\u003e PAN India Presence\r\n              \u003c/div\u003e\r\n              \u003cdiv class=\"about-badge\" style=\"color:black\"\u003e\r\n                \u003ci class=\"fa-solid fa-shield-halved me-2\"\u003e\u003c/i\u003e Trusted by Dealers \u0026 OEMs\r\n              \u003c/div\u003e\r\n                \u003cdiv class=\"about-badge\" style=\"color:black\"\u003e\r\n                \u003ci class=\"fa-solid fa-car-side me-2\"\u003e\u003c/i\u003e  Hassle Free Claims*\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n         \r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n      \u003cdiv class=\"hero-bottom-shape\"\u003e\u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- OUR STORY / COMPANY OVERVIEW --\u003e\r\n    \u003csection class=\"about-section py-5\"\u003e\r\n  \u003cdiv class=\"container\"\u003e\r\n    \u003c!-- yaha ROW chahiye, d-flex nahi --\u003e\r\n    \u003cdiv class=\"row align-items-center gy-4\"\u003e\r\n      \r\n      \u003c!-- LEFT: TEXT --\u003e\r\n      \u003cdiv class=\"col-lg-6\"\u003e\r\n        \u003cspan class=\"section-tag\" style=\"font-size:16px; color:#2d286b\"\u003eOur Story\u003c/span\u003e\r\n         \u003ch1 class=\"about-title\" style=\"color:black; font-weight:700\"\u003e\r\n          Redefining Warranty Through Technology \u0026 Transparency\r\n        \u003c/h1\u003e\r\n        \u003cp class=\"section-text\" style=\"color:black\"\u003e\r\n          Extended Warranty was founded with a simple purpose – to remove the stress\r\n          and unpredictability that comes with sudden breakdowns. Over the years, we have\r\n          built a robust ecosystem that connects customers, dealers, OEMs and service centers through a unified technology platform.\r\n        \u003c/p\u003e\r\n        \u003cp class=\"section-text\" style=\"color:black\"\u003e\r\n          From policy issuance and inspection to claim approvals and repair coordination,\r\n          our systems are designed to deliver a smooth, transparent and quick experience\r\n          for all stakeholders.\r\n        \u003c/p\u003e\r\n\r\n        \u003cdiv class=\"row mt-4 g-3\"\u003e\r\n          \u003cdiv class=\"col-6 col-md-4\"\u003e\r\n            \u003cdiv class=\"about-stat\"\u003e\r\n              \u003ch3\u003e28+\u003c/h3\u003e\r\n              \u003cp\u003eRegional Offices\u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-6 col-md-4\"\u003e\r\n            \u003cdiv class=\"about-stat\"\u003e\r\n              \u003ch3\u003e300+\u003c/h3\u003e\r\n              \u003cp\u003eTeam Members\u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-6 col-md-4\"\u003e\r\n            \u003cdiv class=\"about-stat\"\u003e\r\n              \u003ch3\u003e1000+\u003c/h3\u003e\r\n              \u003cp\u003eAftersales Points\u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- RIGHT: IMAGE --\u003e\r\n      \r\n\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n\r\n    \u003c!-- OUR VALUES --\u003e\r\n    \u003csection class=\"about-section about-values py-5\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"text-center mb-4\"\u003e\r\n          \u003cspan class=\"section-tag\" style=\"font-size:16px; color:#2d286b;\"\u003eWhat We Stand For\u003c/span\u003e\r\n           \u003ch1 class=\"about-title\" style=\"color:black; font-weight:700\"\u003eOur Core Values\u003c/h1\u003e\r\n          \u003cp class=\"section-text\" style=\"color:black\"\u003e\r\n            Every policy, every claim and every interaction is guided by our commitment\r\n            to integrity, transparency and long-term relationships.\r\n          \u003c/p\u003e\r\n        \u003c/div\u003e\r\n\r\n        \u003cdiv class=\"row g-4\"\u003e\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"value-card h-100\"\u003e\r\n              \u003cdiv class=\"value-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-handshake\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch5\u003eTrust \u0026 Transparency\u003c/h5\u003e\r\n              \u003cp class=\"about-subtitle\" style=\"color:black\"\u003e\r\n                Clear terms, fair processes and no hidden surprises – customers and partners\r\n                always know where they stand.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"value-card h-100\"\u003e\r\n              \u003cdiv class=\"value-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-bolt\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch5\u003eSpeed \u0026 Reliability\u003c/h5\u003e\r\n             \u003cp class=\"about-subtitle\" style=\"color:black\"\u003e\r\n                Fast approvals, quick communication and strong service tie-ups ensure minimal\r\n                downtime for customers.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"value-card h-100\"\u003e\r\n              \u003cdiv class=\"value-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-laptop-code\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch5\u003eTechnology-Driven\u003c/h5\u003e\r\n             \u003cp class=\"about-subtitle\" style=\"color:black\"\u003e\r\n                Dealer portals, mobile apps, inspection tools and automated workflows power\r\n                our warranty ecosystem.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"value-card h-100\"\u003e\r\n              \u003cdiv class=\"value-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-heart-circle-check\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch5\u003eCustomer First\u003c/h5\u003e\r\n              \u003cp class=\"about-subtitle\" style=\"color:black\"\u003e\r\n                Our priority is to ensure that every customer experience – from issuance to claim –\r\n                is smooth and reassuring.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003c!-- WHY CUSTOMERS \u0026 PARTNERS TRUST US --\u003e\r\n    \u003csection class=\"about-section py-5\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row gy-4 align-items-center\"\u003e\r\n          \u003c!--\u003cdiv class=\"col-lg-6\"\u003e--\u003e\r\n          \u003c!--  \u003cspan class=\"section-tag\" style=\"font-size:16px\"\u003eWhy Choose Us\u003c/span\u003e--\u003e\r\n          \u003c!--  \u003ch2 class=\"section-title\"\u003e--\u003e\r\n          \u003c!--    Why Customers \u0026 Partners Trust Extended Warranty--\u003e\r\n          \u003c!--  \u003c/h2\u003e--\u003e\r\n          \u003c!--  \u003cul class=\"about-list\"\u003e--\u003e\r\n          \u003c!--    \u003cli style=\"font-size:17px\"\u003e--\u003e\r\n          \u003c!--      \u003ci class=\"fa-solid fa-circle-check me-2\"\u003e\u003c/i\u003e--\u003e\r\n          \u003c!--      Strong tie-ups with authorized service centers and workshops.--\u003e\r\n          \u003c!--    \u003c/li\u003e--\u003e\r\n          \u003c!--    \u003cli style=\"font-size:17px\"\u003e--\u003e\r\n          \u003c!--      \u003ci class=\"fa-solid fa-circle-check me-2\"\u003e\u003c/i\u003e--\u003e\r\n          \u003c!--      Structured inspection and approval process for hassle-free claims.--\u003e\r\n          \u003c!--    \u003c/li\u003e--\u003e\r\n          \u003c!--    \u003cli style=\"font-size:17px\"\u003e--\u003e\r\n          \u003c!--      \u003ci class=\"fa-solid fa-circle-check me-2\"\u003e\u003c/i\u003e--\u003e\r\n          \u003c!--      Products designed for dealers, OEMs, and retail partners.--\u003e\r\n          \u003c!--    \u003c/li\u003e--\u003e\r\n          \u003c!--    \u003cli style=\"font-size:17px\"\u003e--\u003e\r\n          \u003c!--      \u003ci class=\"fa-solid fa-circle-check me-2\"\u003e\u003c/i\u003e--\u003e\r\n          \u003c!--      Dedicated relationship managers and support teams.--\u003e\r\n          \u003c!--    \u003c/li\u003e--\u003e\r\n          \u003c!--    \u003cli style=\"font-size:17px\"\u003e--\u003e\r\n          \u003c!--      \u003ci class=\"fa-solid fa-circle-check me-2\"\u003e\u003c/i\u003e--\u003e\r\n          \u003c!--      Data-driven dashboards, MIS, and performance monitoring.--\u003e\r\n          \u003c!--    \u003c/li\u003e--\u003e\r\n          \u003c!--  \u003c/ul\u003e--\u003e\r\n          \u003c!--\u003c/div\u003e--\u003e\r\n\r\n          \u003cdiv class=\"col-lg-6\"\u003e\r\n            \u003cdiv class=\"about-highlight-box\"\u003e\r\n              \u003ch4\u003eOur Vision\u003c/h4\u003e\r\n              \u003cp class=\"section-text\" style=\"color:black;\"\u003e\r\n                To be India’s most trusted extended warranty partner for automobiles, electronics and home appliances delivering peace of mind through innovation, service excellence,\r\n                and long-term relationships.\r\n              \u003c/p\u003e\r\n              \u003ch4 class=\"mt-3\"\u003eOur Mission\u003c/h4\u003e\r\n              \u003cp class=\"section-text\" style=\"color:black\"\u003e\r\n                To build a transparent, tech-enabled ecosystem that protects every customer’s\r\n                purchase – from the day of sale till the end of its life cycle.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n    \u003cfooter class=\"footer\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch1 class=\"footer-logo\"\u003e\r\n              \u003cimg src=\"./img/EW-Logo 4.png\" alt=\"Logo\" /\u003e\r\n            \u003c/h1\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\r\n              Our extended warranty plans safeguard the products you rely on\r\n              every day—keeping them running smoothly and extending their\r\n              lifespan. From mobility to home essentials, we’ve got you covered.\r\n            \u003c/p\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003eAddress\u003c/h5\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\r\n              \u003ci class=\"fa fa-map-marker-alt me-3\"\u003e\u003c/i\u003eExtended Warranty India\r\n              Private Limited 215, First Floor, DLF South Court Mall, Saket, New\r\n              Delhi, 110017\r\n            \u003c/p\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-phone-alt me-3\"\u003e\u003c/i\u003e+011 49880000\u003c/p\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-envelope me-3\"\u003e\u003c/i\u003econtact@warrantyindia.co.in\u003c/p\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size:18px;font-family: Poppins;\"\u003e\r\n              Quick Links\r\n            \u003c/h5\u003e\r\n            \u003cul class=\"list-unstyled\" \u003e\r\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"about.html\" style=\"font-family: Poppins;font-size:14px\"\u003eAbout Us\u003c/a\u003e\u003c/li\u003e\r\n              \u003cli\u003e\r\n                \u003ca class=\"btn btn-link\" href=\"contact.html\" style=\"font-family: Poppins;font-size:14px\"\u003eContact Us\u003c/a\u003e\r\n              \u003c/li\u003e\r\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"terms-and-conditions.html\" style=\"font-family: Poppins;font-size:14px\"\u003eTerms \u0026 Conditions\u003c/a\u003e\u003c/li\u003e\r\n              \u003cli\u003e\r\n                \u003ca class=\"btn btn-link\" href=\"privacy-policy.html\" style=\"font-family: Poppins;font-size:14px\"\u003ePrivacy Policy\u003c/a\u003e\r\n              \u003c/li\u003e\r\n            \u003c/ul\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003e\r\n              OUR SERVICES\r\n            \u003c/h5\u003e\r\n           \u003cstyle\u003e\r\n  .btn-link {\r\n    display: block;\r\n  }\r\n  .list-unstyled .btn-link {\r\n    white-space: nowrap;\r\n    font-family: Poppins;\r\n    font-size:14px;\r\n  }/* Remove underline from footer links */\r\n.footer a.btn-link {\r\n    text-decoration: none !important;\r\n}\r\n\r\n/* Also remove underline on hover */\r\n.footer a.btn-link:hover {\r\n    text-decoration: none !important;\r\n}\r\n/* ===== FOOTER LEFT ALIGN FIX ===== */\r\n.footer,\r\n.footer * {\r\n  text-align: left !important;\r\n}\r\n\r\n/* Footer links */\r\n.footer .btn-link {\r\n  text-align: left !important;\r\n  padding-left: 0;\r\n}\r\n\r\n/* Remove center alignment added earlier */\r\n.footer .btn-link {\r\n  display: inline-block;\r\n}\r\n\r\n/* Footer columns spacing */\r\n.footer .col-md-3,\r\n.footer .col-md-6 {\r\n  text-align: left !important;\r\n}\r\n\r\n/* Footer logo alignment */\r\n.footer-logo img {\r\n  display: block;\r\n  margin-left: 0;\r\n}\r\n\r\n/* Footer bottom text */\r\n.footer-bottom {\r\n  text-align: left;\r\n}\r\n\r\n\u003c/style\u003e\r\n\r\n\u003cul class=\"list-unstyled\"\u003e\r\n  \u003cli \u003e\r\n    \u003ca class=\"btn btn-link\" href=\"https://truepromise.co.in/warranty/\"\u003eAutomobiles Warranty\u003c/a\u003e\r\n  \u003c/li\u003e\r\n  \r\n  \u003cli\u003e\r\n    \u003ca class=\"btn btn-link\" href=\"https://extracare.co.in/ExtraCare/assimox-html-package/assimox-html-main/index.html\"\u003eElectronics \u0026 Home Appliances\u003c/a\u003e\r\n  \u003c/li\u003e\r\n\u003c/ul\u003e\r\n\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"footer-bottom\"\u003e\r\n          \u003cdiv class=\"col-md-6 text-md-start mb-3 mb-md-0\"\u003e\r\n            © \u003ca style=\"color: #007bff;font-family: Poppins;font-size:14px\"\u003eExtended Warranty\u003c/a\u003e, All\r\n            Right Reserved.\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/footer\u003e\r\n\r\n  \u003c/main\u003e\r\n\r\n\r\n  \u003c!-- Bootstrap JS --\u003e\r\n  \u003cscript src=\"https://code.jquery.com/jquery-3.4.1.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"lib/wow/wow.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"lib/easing/easing.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"lib/waypoints/waypoints.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"lib/owlcarousel/owl.carousel.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"lib/counterup/counterup.min.js\"\u003e\u003c/script\u003e\r\n  \u003cscript src=\"./about.js\"\u003e\u003c/script\u003e\r\n  \r\n  \u003cscript\u003e\r\n  function showdata() {\r\n    let elements = document.getElementsByClassName('buttonforhidden');\r\n    let elements1 = document.getElementsByClassName('navbar-expand-lg');\r\n\r\n            for 