255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1) ; padding: 5px 10px 5px 10px ; \"\u003e Login \u003c/button\u003e \u003cbutton style=\"background-color: #2d286b; color: white; border: 2px solid #2d286b; border-radius: 3px; padding: 5px 10px 5px 10px;\"\u003e Sign up \u003c/button\u003e \u003c/div\u003e --\u003e \u003c/nav\u003e \u003c!-- Navbar End --\u003e \u003c!-- Carousel Start --\u003e \u003csection class=\"hero\"\u003e \u003c!-- TOP TEXT --\u003e \u003cdiv class=\"hero-top\"\u003e \u003ch1\u003e YOUR PEACE OF MIND \u003cbr\u003e OUR PROMISE \u003c/h1\u003e \u003c/div\u003e \u003c!-- MIDDLE = IMAGE ONLY (NO TEXT HERE) --\u003e \u003cdiv class=\"hero-middle\"\u003e\u003c/div\u003e \u003c!-- BOTTOM TEXT --\u003e \u003cdiv class=\"hero-bottom\"\u003e India’s Most Trusted Extended Warranty for Cars, Bikes \u0026 Home Appliances\u003cbr\u003e *Pan India Presence • Genuine Parts • Hassle Free Claims \u003c/div\u003e \u003c/section\u003e \u003csection id=\"ts-features\" class=\"ts-features py-5\" style = 'margin-top:20px;'\u003e \u003cdiv class=\"container\"\u003e \u003cdiv class=\"row align-items-center\"\u003e \u003c!-- Left Column - Main Heading \u0026 Description --\u003e \u003cdiv class=\"col-lg-5 mb-5 mb-lg-0 ts-left-col\"\u003e \u003cdiv class=\"pe-lg-4\"\u003e \u003ch1 class=\"fw-bold mb-4\" style=\"color: #212121; line-height: 1.35; font-weight:700;font-size: 30px;text-transform:uppercase;\"\u003e Your Assets Our Assurance \u003c/h1\u003e \u003cp class=\"text-muted mb-5\" style=\"line-height: 1.7;color:#3b3b3b!important;text-align:justify;font-family: Poppins;\"\u003e At Extended Warranty India, we provide comprehensive warranty solutions for Automobiles, Home Appliances, Electronics, IT Hardware, and Construction Equipment. With extensive industry expertise, we aim to deliver worry-free ownership by shielding ours customers from unforeseen expenses caused by sudden failures or repairs. \u003c/p\u003e \u003c!-- Trust Badges in Grid --\u003e \u003cd