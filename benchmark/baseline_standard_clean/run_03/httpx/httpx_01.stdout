ate":"Fri, 18 Sep 2026 14:54:14 GMT","last_modified":"Tue, 25 Nov 2025 07:45:05 GMT","server":"Apache"},"raw_header":"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 29162\r\nAccept-Ranges: bytes\r\nContent-Type: text/javascript\r\nDate: Fri, 18 Sep 2026 14:54:14 GMT\r\nLast-Modified: Tue, 25 Nov 2025 07:45:05 GMT\r\nServer: Apache\r\n\r\n","request":"GET /plugins/colorbox/jquery.colorbox.js HTTP/1.1\r\nHost: warrantyindia.com\r\nUser-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 13_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Safari/605.1.15\r\nAccept-Charset: utf-8\r\nAccept-Encoding: gzip\r\n\r\n","time":"241.457389ms","a":["101.53.149.53"],"tech":["Apache HTTP Server"],"words":2320,"lines":1105,"status_code":200,"content_length":29162,"failed":false,"knowledgebase":{"PageType":"landing","pHash":0},"resolvers":["[2409:40d0:250b:70b2::de]:53","1.1.1.1:53"],"cpe":[{"product":"webp_server_go","vendor":"webp","cpe":"cpe:2.3:a:webp:webp_server_go:*:*:*:*:*:*:*:*"}]}
{"timestamp":"2026-09-18T10:54:14.160039985-04:00","port":"443","url":"https://warrantyindia.com/plugins/colorbox/colorbox.css","input":"https://warrantyindia.com/plugins/colorbox/colorbox.css","scheme":"https","webserver":"Apache","body":"/*\n    Colorbox Core Style:\n    The following CSS is consistent between example themes and should not be altered.\n*/\n#colorbox, #cboxOverlay, #cboxWrapper{position:absolute; top:0; left:0; z-index:9999; overflow:hidden; -webkit-transform: translate3d(0,0,0);}\n#cboxWrapper {max-width:none;}\n#cboxOverlay{position:fixed; width:100%; height:100%;}\n#cboxMiddleLeft, #cboxBottomLeft{clear:left;}\n#cboxContent{position:relative;}\n#cboxLoadedContent{overflow:auto; -webkit-overflow-scrolling: touch;}\n#cboxTitle{margin:0;}\n#cboxLoadingOverlay, #cboxLoadingGraphic{position:absolute; top:0; left:0; width:100%; height:100%;}\n#cboxPrevious, #cboxNext, #cboxClose, #cboxSlideshow{cursor:pointer;}\n.cboxPhoto{float:left; margin:auto; border:0; display:block; max-width:none; -ms-interpolation-mode:bicubic;}\n.cboxIframe{width:100%; height:100%; display:block; border:0; padding:0; margin:0;}\n#colorbox, #cboxContent, #cboxLoadedContent{box-sizing:content-box; -moz-box-sizing:content-box; -webkit-box-sizing:content-box;}\n\n/* \n    User Style:\n    Change the following styles to modify the appearance of Colorbox.  They are\n    ordered \u0026 tabbed in a way that represents the nesting of the generated HTML.\n*/\n#cboxOverlay{background:#000; background: rgba(0,0,0,.9); opacity: 0.9; filter: alpha(opacity = 90);}\n#colorbox{outline:0;}\n#cboxContent{margin-top:20px;background:#000;}\n.cboxIframe{background:#fff;}\n#cboxError{padding:50px; border:1px solid #ccc;}\n#cboxLoadedContent{border:0 solid #000; background:#fff;}\n#cboxTitle{position:absolute; top:-20px; left:0; color:#ccc;}\n#cboxCurrent{position:absolute; top:0; right:0px; color:#ccc;background-color: rgba(0,0,0,0.95); width: 100%;}\n#cboxLoadingGraphic{background:url(../images/loading.gif) no-repeat center center;}\n\n/* these elements are buttons, and may need to have additional styles reset to avoid unwanted base styles */\n#cboxPrevious, #cboxNext, #cboxSlideshow, #cboxClose {border:0; padding:0; margin:0; overflow:visible; width:auto; background:none;}\n\n/* avoid outlines on :active (mouseclick), but preserve outlines on :focus (tabbed navigating) */\n#cboxPrevious:active, #cboxNext:active, #cboxSlideshow:active, #cboxClose:active {outline:0;}\n\n#cboxSlideshow{position:absolute; top:-20px; right:90px; color:#fff;}\n#cboxPrevious{position:absolute; top:50%; left:0; margin-top:-32px; background:url(controls.png) no-repeat top left; width:28px; height:65px; text-indent:-9999px;}\n#cboxPrevious:hover{background-position:bottom left;}\n#cboxNext{position:absolute; top:50%; right:0; margin-top:-32px; background:url(controls.png) no-repeat top right; width:28px; height:65px; text-indent:-9999px;}\n#cboxNext:hover{background-position:bottom right;}\n#cboxClose{position:absolute; top:5px; right:0; display:block; background:url(controls.png) no-repeat top center; width:38px; height:19px; text-indent:-9999px;}\n#cboxClose:hover{background-position:bottom center;}\nbutton:focus {outline: 0 !important}\n","content_type":"text/css","method":"GET","host":"warrantyindia.com","host_ip":"101.53.149.53","path":"/plugins/colorbox/colorbox.css","header":{"accept_ranges":"bytes","content_length":"2951","content_type":"text/css","date":"Fri, 18 Sep 2026 14:54:14 GMT","last_modified":"Tue, 25 Nov 2025 07:45:05 GMT","server":"Apache"},"raw_header":"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 2951\r\nAccept-Ranges: bytes\r\nContent-Type: text/css\r\nDate: Fri, 18 Sep 2026 14:54:14 GMT\r\nLast-Modified: Tue, 25 Nov 2025 07:45:05 GMT\r\nServer: Apache\r\n\r\n","request":"GET /plugins/colorbox/colorbox.css HTTP/1.1\r\nHost: warrantyindia.com\r\nUser-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/119.0\r\nAccept-Charset: utf-8\r\nAccept-Encoding: gzip\r\n\r\n","time":"287.173024ms","a":["101.53.149.53"],"tech":["Apache HTTP Server"],"words":207,"lines":46,"status_code":200,"content_length":2951,"failed":false,"knowledgebase":{"PageType":"landing","pHash":0},"resolvers":["[2409:40d0:250b:70b2::de]:53","1.1.1.1:53"]}
{"timestamp":"2026-09-18T10:54:14.190534432-04:00","port":"443","url":"https://warrantyindia.com/services.html","input":"https://warrantyindia.com/services.html","title":"Automobile Extended Warranty – Extended Warranty India","scheme":"https","webserver":"Apache","body":"\u003c!DOCTYPE html\u003e\r\n\u003chtml lang=\"en\"\u003e\r\n\u003chead\u003e\r\n  \u003cmeta charset=\"utf-8\" /\u003e\r\n  \u003ctitle\u003eAutomobile Extended Warranty – Extended Warranty India\u003c/title\u003e\r\n  \u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\" /\u003e\r\n\r\n  \u003c!-- Google Fonts --\u003e\r\n  \u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\" /\u003e\r\n  \u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin /\u003e\r\n  \u003clink\r\n    href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500\u0026family=Poppins:wght@500;600;700\u0026display=swap\"\r\n    rel=\"stylesheet\"\r\n  /\u003e\r\n    \u003clink href=\"css/bootstrap.min.css\" rel=\"stylesheet\" /\u003e\r\n    \u003clink\r\n    rel=\"stylesheet\"\r\n    href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"\r\n  /\u003e\r\n\r\n  \u003c!-- Bootstrap 5 --\u003e\r\n  \u003clink\r\n    href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\"\r\n    rel=\"stylesheet\"\r\n  /\u003e\r\n    \u003clink href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css\" rel=\"stylesheet\" /\u003e\r\n  \u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css\" rel=\"stylesheet\" /\u003e\r\n\r\n  \u003c!-- Font Awesome --\u003e\r\n  \u003clink\r\n    rel=\"stylesheet\"\r\n    href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"\r\n  /\u003e\r\n  \r\n  \r\n\r\n  \u003c!-- Page CSS (you can move this into 4W.css later) --\u003e\r\n  \u003cstyle\u003e\r\n  /* MOBILE: navbar background start se visible */\r\n@media (max-width: 991px){\r\n  .navbar{\r\n    background: rgba(17, 15, 58, 0.92) !important;  /* start */\r\n    backdrop-filter: blur(10px);\r\n    -webkit-backdrop-filter: blur(10px);\r\n  }\r\n\r\n  /* when scroll */\r\n  .navbar.scrolled{\r\n    background: rgba(17, 15, 58, 0.98) !important;\r\n  }\r\n\r\n  /* dropdown/collapse menu background */\r\n  .navbar-collapse{\r\n    background: rgba(17, 15, 58, 0.98) !important;\r\n    padding: 12px 14px;\r\n    border-radius: 12px;\r\n  }\r\n}\r\n    body {\r\n      font-family: \"Poppins\", \"Roboto\", sans-serif;\r\n      background: #f5f6fb;\r\n    }\r\n\r\n    /* HERO */\r\n    .auto-hero {\r\n      background:white;\r\n      color: #fff;\r\n      padding: 120px 0 90px;\r\n    }\r\n\r\n    .auto-hero-eyebrow {\r\n      font-size: 0.75rem;\r\n      letter-spacing: 0.16em;\r\n      text-transform: uppercase;\r\n      color: #c6c9ff;\r\n    }\r\n\r\n    .auto-hero-title {\r\n      font-size: 2.4rem;\r\n      font-weight: 800;\r\n      line-height: 1.3;\r\n      margin-top: 12px;\r\n    }\r\n\r\n    .auto-hero-subtitle {\r\n      font-size: 1rem;\r\n      color: #e0e2ff;\r\n      margin-top: 16px;\r\n      max-width: 560px;\r\n    }\r\n\r\n    .auto-hero-badge {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      padding: 7px 14px;\r\n      border-radius: 999px;\r\n      background: rgba(255, 255, 255, 0.1);\r\n      border: 1px solid rgba(255, 255, 255, 0.25);\r\n      font-size: 0.8rem;\r\n      margin-right: 8px;\r\n      margin-bottom: 8px;\r\n    }\r\n\r\n \r\n\r\n    .auto-hero-card h3 {\r\n      font-size: 1.05rem;\r\n      font-weight: 700;\r\n      margin-bottom: 8px;\r\n    }\r\n\r\n    /* SECTION GENERIC */\r\n    .auto-section {\r\n      padding: 60px 0;\r\n      background: #f5f6fb;\r\n    }\r\n\r\n    .auto-section:nth-of-type(even) {\r\n      background: #ffffff;\r\n    }\r\n\r\n    .auto-tag {\r\n      font-size: 0.75rem;\r\n      font-weight: 600;\r\n      text-transform: uppercase;\r\n      letter-spacing: 0.14em;\r\n      color: #2d286b;\r\n    }\r\n\r\n    .auto-title {\r\n      font-weight: 700;\r\n      font-size: 1.7rem;\r\n      margin-top: 6px;\r\n      margin-bottom: 12px;\r\n      color: #212121;\r\n    }\r\n\r\n    .auto-text {\r\n      font-size: 0.95rem;\r\n      color: #555;\r\n      line-height: 1.7;\r\n    }\r\n\r\n    /* HIGHLIGHTS */\r\n    .auto-highlight-card {\r\n      background: #fff;\r\n      border-radius: 14px;\r\n      padding: 18px 16px;\r\n      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);\r\n      height: 100%;\r\n    }\r\n\r\n    .auto-highlight-icon {\r\n      width: 44px;\r\n      height: 44px;\r\n      border-radius: 50%;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      background: #f0f3ff;\r\n      color: #2d286b;\r\n      font-size: 1.2rem;\r\n      margin-bottom: 10px;\r\n    }\r\n\r\n    /* COVERAGE */\r\n    .coverage-pill {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      padding: 6px 12px;\r\n      border-radius: 999px;\r\n      background: #f0f1ff;\r\n      font-size: 0.82rem;\r\n      color: #333;\r\n      margin: 4px;\r\n    }\r\n\r\n    .coverage-pill i {\r\n      margin-right: 6px;\r\n      color: #2d286b;\r\n    }\r\n\r\n    /* PROCESS */\r\n    .step-circle {\r\n      width: 36px;\r\n      height: 36px;\r\n      border-radius: 50%;\r\n      background: #2d286b;\r\n      color: #fff;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      font-weight: 700;\r\n      margin-right: 10px;\r\n      flex-shrink: 0;\r\n    }\r\n\r\n    .auto-step {\r\n      background: #fff;\r\n      border-radius: 12px;\r\n      padding: 14px 16px;\r\n      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);\r\n      height: 100%;\r\n      font-size: 0.9rem;\r\n    }\r\n\r\n    /* FAQ */\r\n    .auto-faq .accordion-button {\r\n      font-size: 0.9rem;\r\n      font-weight: 500;\r\n    }\r\n\r\n    /* CTA */\r\n    .auto-cta {\r\n      background: linear-gradient(90deg, #2d286b, #110f3a);\r\n      color: #fff;\r\n      border-radius: 18px;\r\n      padding: 24px 24px;\r\n    }\r\n\r\n    .btn-auto-primary {\r\n      background: #ffc107;\r\n      border: none;\r\n      color: #111;\r\n      font-weight: 600;\r\n      border-radius: 999px;\r\n      padding: 10px 26px;\r\n      font-size: 0.9rem;\r\n    }\r\n\r\n    .btn-auto-outline {\r\n      border-radius: 999px;\r\n      border: 1px solid #fff;\r\n      color: #fff;\r\n      padding: 9px 22px;\r\n      font-size: 0.9rem;\r\n      background: transparent;\r\n    }\r\n\r\n    @media (max-width: 992px) {\r\n      .auto-hero {\r\n        text-align: center;\r\n        padding: 100px 0 70px;\r\n      }\r\n      .auto-hero-subtitle {\r\n        margin-left: auto;\r\n        margin-right: auto;\r\n      }\r\n      .auto-hero-card {\r\n        margin-top: 20px;\r\n      }\r\n    }\r\n\r\n    @media (max-width: 768px) {\r\n      .auto-hero-title {\r\n        font-size: 1.9rem;\r\n      }\r\n    }\r\n    \r\n    /* B2B / Dealer Benefits */\r\n.auto-b2b {\r\n  background: #ffffff;\r\n}\r\n\r\n.dealer-card {\r\n  background: #f7f7ff;\r\n  border-radius: 14px;\r\n  padding: 16px 14px;\r\n  box-shadow: 0 4px 10px rgba(0,0,0,0.04);\r\n  font-size: 0.88rem;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.dealer-card p {\r\n  color: #555;\r\n}\r\n\r\n.dealer-icon {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  background: #2d286b0f;\r\n  color: #2d286b;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 1.1rem;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.dealer-card:hover {\r\n  transform: translateY(-3px);\r\n  box-shadow: 0 10px 24px rgba(0,0,0,0.12);\r\n  background: #ffffff;\r\n}\r\n\r\n/*** Footer ***/\r\n.footer {\r\n    color: #A7A8B4;\r\n}\r\n\r\n.footer .btn.btn-link {\r\n    display: block;\r\n    margin-bottom: 5px;\r\n    padding: 0;\r\n    text-align: left;\r\n    color: #A7A8B4;\r\n    font-weight: normal;\r\n    text-transform: capitalize;\r\n    transition: .3s;\r\n}\r\n\r\n.footer .btn.btn-link::before {\r\n    position: relative;\r\n    content: \"\\f105\";\r\n    font-family: \"Font Awesome 5 Free\";\r\n    font-weight: 900;\r\n    color: #A7A8B4;\r\n    margin-right: 10px;\r\n}\r\n\r\n.footer .btn.btn-link:hover {\r\n    color: var(--light);\r\n    letter-spacing: 1px;\r\n    box-shadow: none;\r\n}\r\n\r\n.footer .btn.btn-square {\r\n    color: #A7A8B4;\r\n    border: 1px solid#A7A8B4;\r\n}\r\n\r\n.footer .btn.btn-square:hover {\r\n    color: var(--secondary);\r\n    border-color: var(--light);\r\n}\r\n\r\n\r\n.footer .copyright a {\r\n    color: var(--secondary);\r\n}\r\n\r\n.footer .copyright a:hover {\r\n    color: #FFFFFF;\r\n}\r\n/* @media (max-width: 575px) and (min-width: 300px) {\r\n  #containerfooter {\r\n    text-align: left;\r\n    margin-left: 15px;\r\n  }\r\n  .footer-last {\r\n    text-align: left;\r\n    margin-left: 15px;\r\n  }\r\n} */\r\n\r\n.fa-phone-alt {\r\n  transform: none !important;\r\n  direction: ltr !important;\r\n}\r\n\r\n/* .fa-phone-alt {\r\n  transform: none !important;\r\n  direction: ltr !important;\r\n} */\r\n\r\n\r\n\r\n.footer {\r\n  background-color:black !important;\r\n  padding: 50px 0;\r\n}\r\n\r\n.footer a {\r\n  \r\n  text-decoration: none;\r\n}\r\n\r\n.footer a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.footer .social-icons a {\r\n  font-size: 20px;\r\n  margin-right: 15px;\r\n}\r\n\r\n.footer-bottom {\r\n  text-align: center;\r\n  margin-top: 20px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n.footer-logo img {\r\n  width: 150px;\r\n  height: auto;\r\n}\r\n\r\n.btn.btn-outline-primary:hover {\r\n  background-color: transparent !important; /* keep same */\r\n              /* text becomes black */\r\n}\r\n\r\n.featureimg2{\r\n  width: 100vw;\r\n  position: absolute;\r\n  height: 120vh;\r\n  background: rgb(0,0,0,0.4);\r\n  z-index: 1;\r\n  }\r\n\r\n  \u003c/style\u003e\r\n\u003c/head\u003e\r\n\r\n\u003cbody\u003e\r\n\r\n  \u003c!-- YOUR NAVBAR (same style) --\u003e\r\n  \u003cnav class=\"navbar navbar-expand-lg navbar-light sticky-top px-4 px-lg-5\" style=\"position: fixed !important;top: 0px;align-items: center;text-align: center;display: flex; flex-direction: row;width: 100%;height:22%\"\u003e\r\n\r\n      \u003ca href=\"index.html\" class=\"navbar-brand d-flex flex-column align-items-start\"\u003e\r\n  \u003ch1 class=\"m-0\"\u003e\r\n    \u003cimg class=\"img-fluid me-3\"\r\n         src=\"img/EW-Logo 4.png\"\r\n         alt=\"\"\r\n         style=\"max-height: 70px; width: 125px;\" /\u003e\r\n  \u003c/h1\u003e\r\n  \u003ch6 class=\"m-0 text-white fw-normal\"\u003eYour Ultimate Warranty Partner\u003c/h6\u003e\r\n\u003c/a\u003e\r\n\r\n\r\n     \u003cbutton type=\"button\" onclick=\"showdata()\" class=\"navbar-toggler\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarCollapse\" aria-expanded=\"true\"\u003e\r\n        \u003cspan class=\"navbar-toggler-icon\"\u003e\u003c/span\u003e\r\n      \u003c/button\u003e\r\n      \r\n\r\n      \u003cdiv class=\"collapse navbar-collapse\" id=\"navbarCollapse\"\u003e\r\n\r\n        \u003cdiv class=\"navbar-nav rounded pe-4 py-3 py-lg-0\" style=\"margin-left: auto; gap: 20px\"\u003e\r\n           \u003ca href=\"index.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eHome\u003c/a\u003e\r\n          \u003ca href=\"about.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eAbout Us\u003c/a\u003e\r\n\r\n          \u003cdiv class=\"nav-item dropdown\"\u003e\r\n            \u003c!--\u003ca href=\"service.html\" data-bs-toggle=\"dropdown\" class=\"nav-link active\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eOur OFFERINGS\u003c/a\u003e--\u003e\r\n            \u003cdiv class=\"dropdown-menu custom-dropdown\"\u003e\r\n \r\n  \u003ca href=\"https://truepromise.co.in/warranty/\" class=\"dropdown-item\" style=\"font-weight:600;font-family: Poppins;\"\u003eAutomobiles Warranty\u003c/a\u003e\r\n   \u003c!--\u003ca href=\"2W.html\" class=\"dropdown-item\"\u003eTwo Wheeler Warranty\u003c/a\u003e--\u003e\r\n  \u003ca href=\"#\" class=\"dropdown-item\" style=\"font-weight:600;font-family: Poppins;\"\u003eConsumer Durables Warranty\u003c/a\u003e\r\n\u003c/div\u003e\r\n          \u003c/div\u003e\r\n \u003ca href=\"partnerwithuse.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003e Partner With Us \u003c/a\u003e\r\n          \u003ca href=\"contact.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eContact Us\u003c/a\u003e\r\n\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- \u003cdiv class=\"buttonforhidden\"\u003e\r\n        \u003cbutton style=\"border-radius: 12px;color: white; backdrop-filter: blur(1px);\r\n    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1) ; padding: 5px 10px 5px \r\n    10px ; \"\u003e Login \u003c/button\u003e \r\n        \u003cbutton style=\"background-color: #2d286b; color: white; border: 2px solid #2d286b; border-radius: 3px; padding: 5px 10px 5px 10px;\"\u003e Sign up \u003c/button\u003e\r\n      \u003c/div\u003e --\u003e\r\n    \r\n    \u003c/nav\u003e\r\n    \r\n    \u003cdiv class=\"container-fluid page-header py-5 mb-5 wow fadeIn\" data-wow-delay=\"0.1s\" \r\n    style=\"background:  url('./img/darkbg.jpg'); background-size: cover; background-position: center; height: 148px;margin-bottom:0px !important;position:fixed;z-index:100 \"\r\n    \u003e\r\n\r\n    \r\n    \r\n  \u003c/div\u003e\r\n  \u003c!-- MAIN CONTENT --\u003e\r\n  \u003cmain\u003e\r\n\r\n    \u003c!-- HERO --\u003e\r\n    \u003csection class=\"auto-hero\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row align-items-center gy-4\" style=\"margin-top:50px\"\u003e\r\n          \u003cdiv class=\"col-lg-7\"\u003e\r\n            \u003c!--\u003cspan class=\"auto-hero-eyebrow\" style=\"font-size:16px;color:black\"\u003eAutomobile Extended Warranty\u003c/span\u003e--\u003e\r\n            \u003ch1 class=\"auto-hero-title\" style=\"color:black\"\u003e\r\n              Protect Your Car Beyond the Standard Warranty\r\n            \u003c/h1\u003e\r\n            \u003cp class=\"auto-hero-subtitle\" style=\"color:black\"\u003e\r\n              Shield your vehicle from unexpected repair costs with comprehensive coverage\r\n              on engine, transmission, electricals, AC, and more – even after the OEM\r\n              warranty expires.\r\n            \u003c/p\u003e\r\n\r\n            \u003cdiv class=\"mt-4\"\u003e\r\n              \u003cspan class=\"auto-hero-badge\" style=\"color:black\"\u003e\r\n                \u003ci class=\"fa-solid fa-shield-halved me-2\"\u003e\u003c/i\u003e Zero Depreciation Options\r\n              \u003c/span\u003e\r\n              \u003cspan class=\"auto-hero-badge\" style=\"color:black\"\u003e\r\n                \u003ci class=\"fa-solid fa-indian-rupee-sign me-2\"\u003e\u003c/i\u003e Cashless Repair at Network Workshops\r\n              \u003c/span\u003e\r\n              \u003cspan class=\"auto-hero-badge\" style=\"color:black\"\u003e\r\n                \u003ci class=\"fa-solid fa-car-side me-2\"\u003e\u003c/i\u003e Hassle Free Claims*\r\n              \u003c/span\u003e\r\n            \u003c/div\u003e\r\n\r\n            \r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-lg-5 text-lg-end text-center\"\u003e\r\n            \u003cdiv class=\"text-center\" \u003e\r\n             \r\n              \u003cimg src=\"img/service3.png\"\r\n     style=\"box-shadow:10px 10px 10px #2d286b; width:100%; max-width:550px; height:auto; display:block; margin:0 auto;\"\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e\r\n    \r\n        \u003c!-- BENEFITS FOR DEALERS / OEMs (B2B) --\u003e\r\n    \u003csection id=\"b2b\" class=\"auto-section auto-b2b\" style=\"padding-top:0px\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row gy-4 align-items-center\"\u003e\r\n          \r\n          \u003c!-- LEFT: TEXT --\u003e\r\n          \u003cdiv class=\"col-lg-6\"\u003e\r\n            \u003cspan class=\"auto-tag\" style=\"font-size:16px\"\u003eFor Dealers \u0026 OEMs\u003c/span\u003e\r\n            \u003ch2 class=\"auto-title\"\u003eBenefits for Dealers, OEMs \u0026 Channel Partners\u003c/h2\u003e\r\n            \u003cp class=\"auto-text\"\u003e\r\n              Our automobiles extended warranty programs are designed not just for end customers,\r\n              but also to strengthen your dealership and OEM ecosystem. We offer fully managed,\r\n              tech-enabled warranty solutions that enhance customer satisfaction and unlock new\r\n              revenue opportunities.\r\n            \u003c/p\u003e\r\n\r\n            \u003cul class=\"auto-text\" style=\"padding-left: 18px; font-size: 0.9rem;\"\u003e\r\n              \u003cli\u003eReady-to-launch programs for new, used and demo vehicles.\u003c/li\u003e\r\n              \u003cli\u003eEnd-to-end claim management handled by our operations team.\u003c/li\u003e\r\n              \u003cli\u003eBranded or white-label options as per your requirement.\u003c/li\u003e\r\n              \u003cli\u003eDetailed MIS, performance dashboards and regular review support.\u003c/li\u003e\r\n            \u003c/ul\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003c!-- RIGHT: BENEFIT CARDS --\u003e\r\n          \u003cdiv class=\"col-lg-6\"\u003e\r\n            \u003cdiv class=\"row g-3\"\u003e\r\n              \u003cdiv class=\"col-sm-6\"\u003e\r\n                \u003cdiv class=\"dealer-card h-100\"\u003e\r\n                  \u003cdiv class=\"dealer-icon\"\u003e\r\n                    \u003ci class=\"fa-solid fa-face-smile\"\u003e\u003c/i\u003e\r\n                  \u003c/div\u003e\r\n                  \u003ch6 class=\"fw-semibold mb-1\"\u003eHigher Customer Satisfaction\u003c/h6\u003e\r\n                  \u003cp class=\"mb-0\"\u003e\r\n                    Offer extended protection at the point of sale and retain customers\r\n                    within your service network for a longer period.\r\n                  \u003c/p\u003e\r\n                \u003c/div\u003e\r\n              \u003c/div\u003e\r\n\r\n              \u003cdiv class=\"col-sm-6\"\u003e\r\n                \u003cdiv class=\"dealer-card h-100\"\u003e\r\n                  \u003cdiv class=\"dealer-icon\"\u003e\r\n                    \u003ci class=\"fa-solid fa-chart-line\"\u003e\u003c/i\u003e\r\n                  \u003c/div\u003e\r\n                  \u003ch6 class=\"fw-semibold mb-1\"\u003eAdditional Revenue Stream\u003c/h6\u003e\r\n                  \u003cp class=\"mb-0\"\u003e\r\n                    Earn attractive commissions and upsell extended warranty as a value-added product\r\n                    without additional manpower.\r\n                  \u003c/p\u003e\r\n                \u003c/div\u003e\r\n              \u003c/div\u003e\r\n\r\n              \u003cdiv class=\"col-sm-6\"\u003e\r\n                \u003cdiv class=\"dealer-card h-100\"\u003e\r\n                  \u003cdiv class=\"dealer-icon\"\u003e\r\n                    \u003ci class=\"fa-solid fa-gears\"\u003e\u003c/i\u003e\r\n                  \u003c/div\u003e\r\n                  \u003ch6 class=\"fw-semibold mb-1\"\u003eZero Operational Burden\u003c/h6\u003e\r\n                  \u003cp class=\"mb-0\"\u003e\r\n                    We handle underwriting support, policy issuance, claims and customer communication\r\n                    through our centralized team.\r\n                  \u003c/p\u003e\r\n                \u003c/div\u003e\r\n              \u003c/div\u003e\r\n\r\n              \u003cdiv class=\"col-sm-6\"\u003e\r\n                \u003cdiv class=\"dealer-card h-100\"\u003e\r\n                  \u003cdiv class=\"dealer-icon\"\u003e\r\n                    \u003ci class=\"fa-solid fa-laptop-code\"\u003e\u003c/i\u003e\r\n                  \u003c/div\u003e\r\n                  \u003ch6 class=\"fw-semibold mb-1\"\u003eDigital Integration\u003c/h6\u003e\r\n                  \u003cp class=\"mb-0\"\u003e\r\n                    Dealer portal, APIs and inspection tools that seamlessly integrate with your existing\r\n                    sales or DMS workflows.\r\n                  \u003c/p\u003e\r\n                \u003c/div\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n            \u003cdiv class=\"mt-3 text-sm-start text-center\"\u003e\r\n              \u003ca href=\"partnerwithuse.html\" class=\"btn btn-auto-primary\"\u003e\r\n                Become a Partner\r\n              \u003c/a\u003e\r\n              \u003ca href=\"contact.html\" class=\"btn btn-auto-outline ms-sm-2 mt-2 mt-sm-0\"\u003e\r\n                Talk to Our B2B Team\r\n              \u003c/a\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n\r\n    \u003c!-- KEY HIGHLIGHTS --\u003e\r\n    \u003csection class=\"auto-section\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"text-center mb-4\"\u003e\r\n          \u003cspan class=\"auto-tag\" style=\"font-size:16px\"\u003eWhy Choose Our Automobile Warranty\u003c/span\u003e\r\n          \u003ch2 class=\"auto-title\"\u003eKey Highlights\u003c/h2\u003e\r\n          \u003cp class=\"auto-text mx-auto\" style=\"max-width:720px;\"\u003e\r\n            Our automobile extended warranty is designed to keep your automobile running smoothly,\r\n            protect you from high workshop bills, and give you complete peace of mind on every drive.\r\n          \u003c/p\u003e\r\n        \u003c/div\u003e\r\n\r\n        \u003cdiv class=\"row g-4\"\u003e\r\n          \u003cdiv class=\"col-md-4\"\u003e\r\n            \u003cdiv class=\"auto-highlight-card\"\u003e\r\n              \u003cdiv class=\"auto-highlight-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-screwdriver-wrench\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch6 class=\"fw-semibold mb-2\"\u003eComprehensive Mechanical \u0026 Electrical Cover\u003c/h6\u003e\r\n              \u003cp class=\"auto-text mb-0\"\u003e\r\n                Major components like engine, gearbox, differential, ECU, fuel system, steering and more are protected\r\n                as per plan terms.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-4\"\u003e\r\n            \u003cdiv class=\"auto-highlight-card\"\u003e\r\n              \u003cdiv class=\"auto-highlight-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-file-shield\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch6 class=\"fw-semibold mb-2\"\u003eCashless Claims at Network Workshops\u003c/h6\u003e\r\n              \u003cp class=\"auto-text mb-0\"\u003e\r\n                Enjoy hassle-free, cashless repairs at our authorized garages and dealer workshops across India.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-4\"\u003e\r\n            \u003cdiv class=\"auto-highlight-card\"\u003e\r\n              \u003cdiv class=\"auto-highlight-icon\"\u003e\r\n                \u003ci class=\"fa-solid fa-gauge-high\"\u003e\u003c/i\u003e\r\n              \u003c/div\u003e\r\n              \u003ch6 class=\"fw-semibold mb-2\"\u003eFlexible Tenure \u0026 KM Options\u003c/h6\u003e\r\n              \u003cp class=\"auto-text mb-0\"\u003e\r\n                Multiple plan combinations that extend protection up to 10 years and high mileage usage.\r\n              \u003c/p\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n   \r\n\r\n    \u003c!-- HOW IT WORKS --\u003e\r\n    \u003csection id=\"how-it-works\" class=\"auto-section\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"text-center mb-4\"\u003e\r\n          \u003cspan class=\"auto-tag\" style=\"font-size:16px\"\u003eSimple \u0026 Transparent\u003c/span\u003e\r\n          \u003ch2 class=\"auto-title\"\u003eHow Our Automobile Warranty Works\u003c/h2\u003e\r\n        \u003c/div\u003e\r\n\r\n        \u003cdiv class=\"row g-3\"\u003e\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"auto-step d-flex\"\u003e\r\n              \u003cdiv class=\"step-circle\"\u003e1\u003c/div\u003e\r\n              \u003cdiv\u003e\r\n                \u003ch6 class=\"fw-semibold mb-1\" style=\"font-size:0.9rem;\"\u003eChoose Your Plan\u003c/h6\u003e\r\n                \u003cp class=\"mb-0\" style=\"font-size:0.82rem;\"\u003e\r\n                  Select a suitable plan and tenure at the time of purchase or within the eligible period.\r\n                \u003c/p\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"auto-step d-flex\"\u003e\r\n              \u003cdiv class=\"step-circle\"\u003e2\u003c/div\u003e\r\n              \u003cdiv\u003e\r\n                \u003ch6 class=\"fw-semibold mb-1\" style=\"font-size:0.9rem;\"\u003eEasy Enrolment\u003c/h6\u003e\r\n                \u003cp class=\"mb-0\" style=\"font-size:0.82rem;\"\u003e\r\n                  Vehicle details, KM reading and basic inspection (where required) are completed digitally.\r\n                \u003c/p\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"auto-step d-flex\"\u003e\r\n              \u003cdiv class=\"step-circle\"\u003e3\u003c/div\u003e\r\n              \u003cdiv\u003e\r\n                \u003ch6 class=\"fw-semibold mb-1\" style=\"font-size:0.9rem;\"\u003eDrive Confidently\u003c/h6\u003e\r\n                \u003cp class=\"mb-0\" style=\"font-size:0.82rem;\"\u003e\r\n                  Enjoy worry-free driving with coverage active for the chosen period / KM.\r\n                \u003c/p\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n\r\n          \u003cdiv class=\"col-md-3 col-6\"\u003e\r\n            \u003cdiv class=\"auto-step d-flex\"\u003e\r\n              \u003cdiv class=\"step-circle\"\u003e4\u003c/div\u003e\r\n              \u003cdiv\u003e\r\n                \u003ch6 class=\"fw-semibold mb-1\" style=\"font-size:0.9rem;\"\u003eClaim Support\u003c/h6\u003e\r\n                \u003cp class=\"mb-0\" style=\"font-size:0.82rem;\"\u003e\r\n                  In case of breakdown, visit a network workshop – our team coordinates approvals \u0026 cashless settlement.\r\n                \u003c/p\u003e\r\n              \u003c/div\u003e\r\n            \u003c/div\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n\r\n      \u003c/div\u003e\r\n    \u003c/section\u003e\r\n\r\n  \r\n\r\n  \u003c/main\u003e\r\n\r\n  \u003c!-- Simple footer placeholder (replace with your global footer if you want) --\u003e\r\n  \u003c!-- Footer Start --\u003e\r\n   \u003cfooter class=\"footer\"\u003e\r\n      \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch1 class=\"footer-logo\"\u003e\r\n              \u003cimg src=\"./img/EW-Logo 4.png\" alt=\"Logo\" /\u003e\r\n            \u003c/h1\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\r\n              Our extended warranty plans safeguard the products you rely on\r\n              every day—keeping them running smoothly and extending their\r\n              lifespan. From mobility to home essentials, we’ve got you covered.\r\n            \u003c/p\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003eAddress\u003c/h5\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\r\n              \u003ci class=\"fa fa-map-marker-alt me-3\"\u003e\u003c/i\u003eExtended Warranty India\r\n              Private Limited 215, First Floor, DLF South Court Mall, Saket, New\r\n              Delhi, 110017\r\n            \u003c/p\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-phone-alt me-3\"\u003e\u003c/i\u003e+011 49880000\u003c/p\u003e\r\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-envelope me-3\"\u003e\u003c/i\u003econtact@warrantyindia.co.in\u003c/p\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size:18px;font-family: Poppins;\"\u003e\r\n              Quick Links\r\n            \u003c/h5\u003e\r\n            \u003cul class=\"list-unstyled\" \u003e\r\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"about.html\" style=\"font-family: Poppins;font-size:14px\"\u003eAbout Us\u003c/a\u003e\u003c/li\u003e\r\n              \u003cli\u003e\r\n                \u003ca class=\"btn btn-link\" href=\"contact.html\" style=\"font-family: Poppins;font-size:14px\"\u003eContact Us\u003c/a\u003e\r\n              \u003c/li\u003e\r\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"terms-and-conditions.html\" style=\"font-family: Poppins;font-size:14px\"\u003eTerms \u0026 Conditions\u003c/a\u003e\u003c/li\u003e\r\n              \u003cli\u003e\r\n                \u003ca class=\"btn btn-link\" href=\"privacy-policy.html\" style=\"font-family: Poppins;font-size:14px\"\u003ePrivacy Policy\u003c/a\u003e\r\n              \u003c/li\u003e\r\n            \u003c/ul\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"col-md-3\"\u003e\r\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003e\r\n              OUR SERVICES\r\n            \u003c/h5\u003e\r\n           \u003cstyle\u003e\r\n  .btn-link {\r\n    display: block;\r\n  }\r\n  .list-unstyled .btn-link {\r\n    white-space: nowrap;\r\n    font-family: Poppins;\r\n    font-size:14px;\r\n  }/* Remove underline from footer links */\r\n.footer a.btn-link {\r\n    text-decoration: none !important;\r\n}\r\n\r\n/* Also remove underline on hover */\r\n.footer a.btn-link:hover {\r\n    text-decoration: none !important;\r\n}\r\n/* ===== FOOTER LEFT ALIGN FIX ===== */\r\n.footer,\r\n.footer * {\r\n  text-align: left !important;\r\n}\r\n\r\n/* Footer links */\r\n.footer .btn-link {\r\n  text-align: left !important;\r\n  padding-left: 0;\r\n}\r\n\r\n/* Remove center alignment added earlier */\r\n.footer .btn-link {\r\n  display: inline-block;\r\n}\r\n\r\n/* Footer columns spacing */\r\n.footer .col-md-3,\r\n.footer .col-md-6 {\r\n  text-align: left !important;\r\n}\r\n\r\n/* Footer logo alignment */\r\n.footer-logo img {\r\n  display: block;\r\n  margin-left: 0;\r\n}\r\n\r\n/* Footer bottom text */\r\n.footer-bottom {\r\n  text-align: left;\r\n}\r\n\r\n\u003c/style\u003e\r\n\r\n\u003cul class=\"list-unstyled\"\u003e\r\n  \u003cli \u003e\r\n    \u003ca class=\"btn btn-link\" href=\"https://truepromise.co.in/warranty/\"\u003eAutomobiles Warranty\u003c/a\u003e\r\n  \u003c/li\u003e\r\n  \r\n  \u003cli\u003e\r\n    \u003ca class=\"btn btn-link\" href=\"https://extracare.co.in/ExtraCare/assimox-html-package/assimox-html-main/index.html\"\u003eElectronics \u0026 Home Appliances\u003c/a\u003e\r\n  \u003c/li\u003e\r\n\u003c/ul\u003e\r\n\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"footer-bottom\"\u003e\r\n          \u003cdiv class=\"col-md-6 text-md-start mb-3 mb-md-0\"\u003e\r\n            © \u003ca style=\"color: #007bff;font-family: Poppins;font-size:14px\"\u003eExtended Warranty\u003c/a\u003e, All\r\n            Right Reserved.\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/footer\u003e\r\n\r\n  \u003c!-- Bootstrap JS --\u003e\r\n  \u003cscript src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js\"\u003e\u003c/script\u003e\r\n\r\n  \u003cscript\u003e\r\n    // If you still use this for mobile behavior, keep it\r\n    function showdata() {\r\n      let elements = document.getElementsByClassName('buttonforhidden');\r\n      let elements1 = document.getElementsByClassName('navbar-expand-lg');\r\n\r\n      for (let i = 0; i \u003c elements.length; i++) {\r\n        if (elements[i].style.display === 'none' || elements[i].style.display === '') {\r\n          elements[i].style.display = 'block';\r\n          elements[i].style.margin = 'auto';\r\n          elements1[i].style.background = 'black';\r\n        } else {\r\n          elements[i].style.display = '';\r\n          elements1[i].style.background = '';\r\n        }\r\n      }\r\n    }\r\n  \u003c/script\u003e\r\n\u003c/body\u003e\r\n\u003c/html\u003e\r\n","content_type":"text/html","method":"GET","host":"warrantyindia.com","host_ip":"101.53.149.53","path":"/services.html","header":{"accept_ranges":"bytes","content_length":"27189","content_type":"text/html","date":"Fri, 18 Sep 2026 14:54:14 GMT","last_modified":"Wed, 17 Dec 2025 11:08:21 GMT","server":"Apache"},"raw_header":"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 27189\r\nAccept-Ranges: bytes\r\nContent-Type: text/html\r\nDate: Fri, 18 Sep 2026 14:54:14 GMT\r\nLast-Modified: Wed, 17 Dec 2025 11:08:21 GMT\r\nServer: Apache\r\n\r\n","request":"GET /services.html HTTP/1.1\r\nHost: warrantyindia.com\r\nUser-Agent: Mozilla/5.0 (Windows NT 10.0; rv:102.0) Gecko/20100101 Firefox/102.0\r\nAccept-Charset: utf-8\r\nAccept-Encoding: gzip\r\n\r\n","time":"243.43331ms","a":["101.53.149.53"],"tech":["Apache HTTP Server","Bootstrap:5.3.2","jsDelivr"],"words":6815,"lines":873,"status_code":200,"content_length":27189,"failed":false,"knowledgebase":{"PageType":"landing","pHash":0},"resolvers":["[2409:40d0:250b:70b2::de]:53","1.1.1.1:53"]}
