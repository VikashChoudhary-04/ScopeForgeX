u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/section\u003e \u003c!-- Add Font Awesome for icons --\u003e \u003c!-- \u003csection id=\"facts\" class=\"facts-area dark-bg\" style=\"background: linear-gradient(rgba(0, 0, 0, .7), rgba(0, 0, 0, .7)),url(./img/under_hand.jpg);background-size: cover; background-position: center; \"\u003e \u003cdiv class=\"container\" \u003e \u003cdiv class=\"facts-wrapper\"\u003e \u003cdiv class=\"row\"\u003e --\u003e \u003c!-- \u003cdiv class=\"col-md-3 col-sm-6 ts-facts\"\u003e \u003cdiv class=\"ts-facts-img\"\u003e \u003ci class=\"fa-solid fa-file\" style=\"font-size: 35px\" aria-hidden=\"true\" \u003e\u003c/i\u003e \u003c/div\u003e \u003cdiv class=\"ts-facts-content\"\u003e \u003ch2 class=\"ts-facts-num\"\u003e \u003cspan class=\"counterUp\" data-start=\"1700\" data-count=\"1789\" data-specific-number=\"2000\"\u003e1789\u003c/span\u003e \u003c/h2\u003e \u003ch3 class=\"ts-facts-title text-white\"\u003eProjects Succeed\u003c/h3\u003e \u003c/div\u003e \u003c/div\u003e --\u003e \u003c!-- Col end --\u003e \u003c!-- \u003cdiv class=\"col-md-3 col-sm-6 ts-facts mt-5 mt-sm-0\"\u003e \u003cdiv class=\"ts-facts-img\"\u003e \u003ci class=\"fa-solid fa-person\" style=\"font-size: 35px\" aria-hidden=\"true\" \u003e\u003c/i\u003e \u003c/div\u003e \u003cdiv class=\"ts-facts-content\"\u003e \u003ch2 class=\"ts-facts-num\"\u003e \u003cspan class=\"counterUp\" data-start=\"550\" data-count=\"647\" data-specific-number=\"750\"\u003e647\u003c/span\u003e \u003c/h2\u003e \u003ch2 class=\"ts-facts-title text-white\"\u003eHappy Clients\u003c/h2\u003e \u003c/div\u003e \u003c/div\u003e --\u003e \u003c!-- Col end --\u003e \u003c!-- \u003cdiv class=\"col-md-3 col-sm-6 ts-facts mt-5 mt-md-0\"\u003e \u003cdiv class=\"ts-facts-img\"\u003e \u003ci class=\"fa-solid fa-award\" style=\"font-size: 35px\" aria-hidden=\"true\" \u003e\u003c/i\u003e \u003c/div\u003e \u003cdiv class=\"ts-facts-content\"\u003e \u003ch2 class=\"ts-facts-num\"\u003e \u003cspan class=\"counterUp\" data-start=\"3900\" data-count=\"4000\" data-specific-number=\"4400\"\u003e4000\u003c/span\u003e \u003c/h2\u003e \u003ch3 class=\"ts-facts-title text-white\"\u003eAwards Achieved\u003c/h3\u003e \u003c/div\u003e \u003c/div\u003e --\u003e \u003c!-- \u003cdiv class=\"col-md-3 col-sm-6 ts-facts mt-5 mt-md-0\"\u003e \u003cdiv class=\"ts-facts-img\"\u003e \u003ci class=\"fa-solid fa-user-plus\" style=\"font-size: 35px\" aria-hidden=\"true\" \u003e\u003c/i\u003e \u003c/div\u003e \u003cdiv class=\"ts-facts-content\"\u003e \u003ch2 class=\"ts-facts-num\"\u003e \u003cspan class=\"counterUp\" data-start=\"0\" data-count=\"44\" data-specific-number=\"57\"\u003e44\u003c/span\u003e \u003c/h2\u003e \u003ch3 class=\"ts-facts-title text-white\"\u003eTeam Members\u003c/h3\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/section\u003e --\u003e \u003c!-- Extended Warranty Service Sections Start --\u003e \u003cdiv class=\"container-xxl py-5 workimg\"\u003e \u003cdiv class=\"container\"\u003e \u003cdiv class=\"text-center mx-auto\" style=\"max-width: 700px\"\u003e \u003ch1 class=\"section-sub-title mb-5\" style=\" font-weight: 700; font-size: 30px; line-height: 1.3; margin: 0 0 60px; color: #212121; text-transform: uppercase;\"\u003eExtended Warranty Solutions\u003c/h1\u003e \u003c/div\u003e \u003cdiv class=\"row g-4 justify-content-evenly\"\u003e \u003cdiv class=\"col-lg-4 col-md-6 wow fadeInUp\" data-wow-delay=\"0.1s\"\u003e \u003cdiv class=\"service-item rounded h-100 p-4 d-flex flex-column\" style=\" background-color: #f8f9fa; border-left: 4px solid #2d286b; transition: transform 0.3s ease-in-out; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); height: 100%; \" \u003e \u003cdiv class=\"d-flex align-items-center mb-3\"\u003e \u003cdiv class=\"service-icon flex-shrink-0 rounded-circle me-3\" style=\" background-color: #2d286b; border: 2px solid #2d286b; padding: 12px; \" \u003e \u003cimg class=\"img-fluid\" src=\"img/icon/icon-08-light.png\" alt=\"\" style=\"width: 35px; height: 35px\" /\u003e \u003c/div\u003e \u003ch4 class=\"text-dark mb-0\" style=\" font-weight: 700 !important; font-size: 1.1rem; \" \u003e Automobiles \u003c/h4\u003e \u003c/div\u003e \u003cp class=\"text-dark mb-4 flex-grow-1\" style=\"font-size: 16px; font-weight: 400; line-height: 1.5;color:#3b3b3b!important;font-family: Poppins;\" \u003e Your Automobile is more than transportation, it’s an investment. Our complete coverage protects you from unexpected repair costs, giving you the freedom to enjoy every journey with complete peace of mind. \u003c/p\u003e \u003cdiv class=\"mt-auto\"\u003e \u003ca class=\"btn btn-outline-primary px-4 py-2 d-inline-block\" href=\"services.html\" style=\"font-family: Poppins; font-size: 14px; font-weight: 400; border-radius: 25px; color: #2d286b; border: 2px solid #2d286b; text-transform: uppercase; transition: background-color 0.3s ease; padding-left: 30px; padding-right: 30px; \" \u003e Learn More \u003c/a\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003cdiv class=\"col-lg-4 col-md-6 wow fadeInUp\" data-wow-delay=\"0.3s\"\u003e \u003cdiv class=\"service-item rounded h-100 p-4 d-flex flex-column\" style=\" background-color: #f8f9fa; border-left: 4px solid #28a745; transition: transform 0.3s ease-in-out; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); height: 100%; \" \u003e \u003cdiv class=\"d-flex align-items-center mb-3\"\u003e \u003cdiv class=\"service-icon flex-shrink-0 rounded-circle me-3\" style=\" background-color: #28a745; border: 2px solid #28a745; padding: 12px; \" \u003e \u003cimg class=\"img-fluid\" src=\"img/icon/icon-05-light.png\" alt=\"\" style=\"width: 35px; height: 35px\" /\u003e \u003c/div\u003e \u003ch4 class=\"text-dark mb-0\" style=\" font-weight: 700 !important; font-size: 1.1rem; \" \u003e Electronics \u0026 Consumer Durables \u003c/h4\u003e \u003c/div\u003e \u003cp class=\"text-dark mb-4 flex-grow-1\" style=\"font-size: 16px; font-weight: 400; line-height: 1.5;color:#3b3b3b!important;font-family: Poppins;\" \u003e We offer comprehensive coverage for a wide range of electronic devices, shielding you from unexpected repairs and ensuring your gadgets continue to perform reliably. \u003c/p\u003e \u003cdiv class=\"mt-auto\"\u003e \u003ca class=\"btn btn-outline-primary px-4 py-2 d-inline-block\" href=\"#\" style=\"font-family: Poppins; font-size: 14px; font-weight: 400; border-radius: 25px; color: #28a745; border: 2px solid #28a745; text-transform: uppercase; transition: background-color 0.3s ease; padding-left: 30px; padding-right: 30px; \" \u003e Learn More \u003c/a\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003cdiv class=\"col-lg-4 col-md-6 wow fadeInUp\" data-wow-delay=\"0.3s\"\u003e \u003cdiv class=\"service-item rounded h-100 p-4 d-flex flex-column\" style=\" background-color: #f8f9fa; border-left: 4px solid #ff8c00; transition: transform 0.3s ease-in-out; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); height: 100%; \" \u003e \u003cdiv class=\"d-flex align-items-center mb-3\"\u003e \u003cdiv class=\"service-icon flex-shrink-0 rounded-circle me-3\" style=\" background-color: #ff8c00; border: 2px solid #ff8c00; padding: 12px; \" \u003e \u003cimg class=\"img-fluid\" src=\"img/icon/icon-08-light.png\" alt=\"\" style=\"width: 35px; height: 35px\" /\u003e \u003c/div\u003e \u003ch4 class=\"text-dark mb-0\" style=\" font-weight: 700 !important; font-size: 1.1rem; \" \u003e Pre-Owned Vehicle \u003c/h4\u003e \u003c/div\u003e \u003cp class=\"text-dark mb-4 flex-grow-1\" style=\"font-size: 16px; font-weight: 400; line-height: 1.5;color:#3b3b3b!important;font-family: Poppins;\" \u003e Explore our pre-owned vehicle warranty solutions and drive with confidence, knowing your investment is protected. \u003c/p\u003e \u003cdiv class=\"mt-auto\"\u003e \u003ca class=\"btn btn-outline-primary px-4 py-2 d-inline-block\" href=\"https://truepromise.co.in/warranty/\" style=\"font-family: Poppins; font-size: 14px; font-weight: 400; border-radius: 25px; color: #ff8c00; border: 2px solid #ff8c00; text-transform: uppercase; transition: background-color 0.3s ease; padding-left: 30px; padding-right: 30px; \" \u003e Learn More \u003c/a\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c/div\u003e \u003c!-- Extended Warranty Service Sections End --\u003e \u003cstyle\u003e .service-box-title a { display: inline-block; padding: 5px 14px; border-radius: 8px; background: linear-gradient( to right, rgba(45, 40, 107, 0.22), /* ✅ darker */ rgba(45, 40, 107, 0.12) ); transition: all 0.3s ease; } .service-box-title a:hover { background: linear-gradient( to right, rgba(45, 40, 107, 0.35), /* ✅ darker hover */ rgba(45, 40, 107, 0.20) ); } /* Make \u003cp\u003e clickable */ .ts-service-box-info p { cursor: pointer; color:#3b3b3b!important; transition: color 0.3s ease; } .logo-slider { overflow: hidden; position: relative; width: 100%; padding: 0px; margin:0px; } .logo-track { display: flex; width: calc(250px * 14); /* (Logo width × Total logos including duplicates) */ animation: scroll 20s linear infinite; } .client-logo { height: 80px; width: auto; margin: 0 40px; object-fit: contain; filter: grayscale(0%); transition: transform 0.3s; } .client-logo:hover { transform: scale(1.1); } /* Animation */ @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } } \u003c/style\u003e \u003c!--\u003csection id=\"ts-service-area\" class=\"ts-service-area pb-0\"\u003e--\u003e \u003c!-- \u003cdiv class=\"container\"\u003e--\u003e \u003c!-- \u003cdiv class=\"row text-center\"\u003e--\u003e \u003c!-- \u003cdiv class=\"col-12\"\u003e--\u003e \u003c!-- \u003ch2 class=\"section-sub-title\" style=' font-weight: 700;--\u003e \u003c!--font-size: 30px;--\u003e \u003c!--line-height: 1.3;--\u003e \u003c!--margin: 0 0 60px;--\u003e \u003c!--color: #212121;'\u003eOur Service Offerings\u003c/h2\u003e--\u003e \u003c!-- \u003c/div\u003e--\u003e \u003c!-- \u003c/div\u003e--\u003e \u003c!-- \u003cdiv class=\"row\"\u003e--\u003e \u003c!-- LEFT COLUMN --\u003e \u003c!-- \u003cdiv class=\"col-lg-4\"\u003e--\u003e \u003c!-- \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e \u003c!-- \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e \u003c!-- \u003ci class=\"fa-solid fa-shield-halved\" style=\"font-size: 30px\"\u003e\u003c/i\u003e--\u003e \u003c!-- \u003c/div\u003e--\u003e \u003c!-- \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e \u003c!-- \u003ch3 class=\"service-box-title\"\u003e--\u003e \u003c!-- \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/Auto_Mobile.jpg')\" style = 'font-weight: 700 !important;--\u003e \u003c!-- font-size: 1.1rem;color:#fff;background-color:#2d286b'\u003eAutomobile Services\u003c/a\u003e--\u003e \u003c!-- \u003c/h3\u003e--\u003e \u003c!-- \u003cp onclick=\"switchImage('./img/Auto_Mobile.jpg')\"\u003e--\u003e \u003c!-- Expert repair and maintenance for Automobile to keep your automobile running smoothly and reliably.--\u003e \u003c!-- \u003c/p\u003e--\u003e \u003c!-- \u003c/div\u003e--\u003e \u003c!-- \u003c/div\u003e--\u003e \u003c!-- \u003cdiv class=\"ts-service-box d-flex\"\u003e--\u003e \u003c!-- \u003cdiv class=\"ts-service-box-img\"\u003e--\u003e \u003c!-- \u003ci class=\"fa-solid fa-house\" style=\"font-size: 30px;\"\u003e\u003c/i\u003e--\u003e \u003c!-- \u003c/div\u003e--\u003e \u003c!-- \u003cdiv class=\"ts-service-box-info\"\u003e--\u003e \u003c!-- \u003ch3 class=\"service-box-title\"\u003e--\u003e \u003c!-- \u003ca href=\"javascript:void(0)\" onclick=\"switchImage('./img/Home_appliances.jpg')\" style = 'font-weight: 700 !important;--\u003e \u003c!-- font-size: 1.1rem;color:#fff;background-color:#2d286b'\u003eHome Appliance Repair\u003c/a\u003e--\u003e \u003c!-- \u003c/h3\u003e--\u003e \u003c!-- \u003cp onclick=\"switchImage('./img/Home_appliances.jpg')\"\u003e--\u003e \u