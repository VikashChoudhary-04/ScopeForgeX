{"timestamp":"2026-09-18T10:54:14.485535908-04:00","port":"443","url":"https://warrantyindia.com/contact.html","input":"https://warrantyindia.com/contact.html","title":"Extended Warranty","scheme":"https","webserver":"Apache","body":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\n\u003chead\u003e\n  \u003cmeta charset=\"utf-8\" /\u003e\n  \u003ctitle\u003eExtended Warranty\u003c/title\u003e\n  \u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\" /\u003e\n  \u003cmeta content=\"\" name=\"keywords\" /\u003e\n  \u003cmeta content=\"\" name=\"description\" /\u003e\n\n  \u003c!-- Favicon --\u003e\n  \u003clink href=\"img/favicon.ico\" rel=\"icon\" /\u003e\n\n  \u003c!-- Google Web Fonts --\u003e\n  \u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\" /\u003e\n  \u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin /\u003e\n  \u003clink href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;500\u0026family=Poppins:wght@600;700\u0026display=swap\"\n    rel=\"stylesheet\" /\u003e\n\n  \u003c!-- Icon Font Stylesheet --\u003e\n  \u003clink href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css\" rel=\"stylesheet\" /\u003e\n  \u003clink href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css\" rel=\"stylesheet\" /\u003e\n\n  \u003c!-- Libraries Stylesheet --\u003e\n  \u003clink href=\"lib/animate/animate.min.css\" rel=\"stylesheet\" /\u003e\n  \u003clink href=\"lib/owlcarousel/assets/owl.carousel.min.css\" rel=\"stylesheet\" /\u003e\n\n  \u003c!-- Customized Bootstrap Stylesheet --\u003e\n  \u003clink href=\"css/bootstrap.min.css\" rel=\"stylesheet\" /\u003e\n\n  \u003c!-- Template Stylesheet --\u003e\n  \u003clink href=\"css/style.css\" rel=\"stylesheet\" /\u003e\n  \u003clink rel=\"stylesheet\" href=\"index.css\"\u003e\n  \u003clink rel=\"stylesheet\" href=\"./css/newstyle.css\"\u003e\n  \u003clink rel=\"stylesheet\" href=\"contact.css\"\u003e\n  \u003clink\n    rel=\"stylesheet\"\n    href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\"\n  /\u003e\n\u003cstyle\u003e\n/* MOBILE: navbar background start se visible */\n@media (max-width: 991px){\n  .navbar{\n    background: rgba(17, 15, 58, 0.92) !important;  /* start */\n    backdrop-filter: blur(10px);\n    -webkit-backdrop-filter: blur(10px);\n  }\n\n  /* when scroll */\n  .navbar.scrolled{\n    background: rgba(17, 15, 58, 0.98) !important;\n  }\n\n  /* dropdown/collapse menu background */\n  .navbar-collapse{\n    background: rgba(17, 15, 58, 0.98) !important;\n    padding: 12px 14px;\n    border-radius: 12px;\n  }\n}\n  .footer .copyright {\n    padding: 25px 0;\n    margin-left: -25px !important;\n    border-top: 1px solid rgba(256, 256, 256, .1);\n  }\n\n  .map-container {\n    max-width: 1200px;\n    margin: 20px auto;\n    padding: 16px;\n    background: #fff;\n    border-radius: 12px;\n    box-shadow: 0 4px 16px rgba(0,0,0,0.08);\n  }\n\n  .map-container h2 {\n    margin: 0 0 10px;\n    color: #29166f;\n    font-weight: 600;\n    text-align: center;\n  }\n\n  #map {\n    width: 100%;\n    height: 650px;\n    border-radius: 10px;\n    overflow: hidden;\n  }\n\n  .map-pin {\n    width: 26px;\n    height: 26px;\n    background: #29166f;\n    border-radius: 50% 50% 50% 0;\n    position: relative;\n    transform: rotate(-45deg);\n    border: 3px solid #ffffff;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.4);\n  }\n  .map-pin::after {\n    content: \"\";\n    width: 10px;\n    height: 10px;\n    background: #ffffff;\n    border-radius: 50%;\n    position: absolute;\n    top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n  }\n  /* Make attribution subtle but still visible */\n.leaflet-control-attribution {\n  font-size: 9px;\n  background: rgba(255, 255, 255, 0.7);\n  border-radius: 10px;\n  padding: 2px 8px;\n  margin: 8px;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.15);\n  display:none !important;\n}\n\u003c/style\u003e\n\n \n\u003c/head\u003e\n\n\u003cbody\u003e\n  \u003c!-- Spinner Start --\u003e\n  \u003cdiv id=\"spinner\"\n    class=\"show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center\"\u003e\n    \u003cdiv class=\"spinner-grow text-primary\" role=\"status\"\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  \u003c!-- Spinner End --\u003e\n\n\n\n  \u003c!-- Navbar Start --\u003e\n\n\n    \u003cnav class=\"navbar navbar-expand-lg navbar-light sticky-top px-4 px-lg-5\" style=\"position: fixed !important;top: 0px;align-items: center;text-align: center;display: flex; flex-direction: row;width: 100%;height:22%\"\u003e\n\n      \u003ca href=\"index.html\" class=\"navbar-brand d-flex flex-column align-items-start\"\u003e\n  \u003ch1 class=\"m-0\"\u003e\n    \u003cimg class=\"img-fluid me-3\"\n         src=\"img/EW-Logo 4.png\"\n         alt=\"\"\n         style=\"max-height: 70px; width: 125px;\" /\u003e\n  \u003c/h1\u003e\n  \u003ch6 class=\"m-0 text-white fw-normal\"\u003eYour Ultimate Warranty Partner\u003c/h6\u003e\n\u003c/a\u003e\n\n\n     \u003cbutton type=\"button\" onclick=\"showdata()\" class=\"navbar-toggler\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarCollapse\" aria-expanded=\"true\"\u003e\n        \u003cspan class=\"navbar-toggler-icon\"\u003e\u003c/span\u003e\n      \u003c/button\u003e\n      \n\n      \u003cdiv class=\"collapse navbar-collapse\" id=\"navbarCollapse\"\u003e\n\n        \u003cdiv class=\"navbar-nav rounded pe-4 py-3 py-lg-0\" style=\"margin-left: auto; gap: 20px\"\u003e\n           \u003ca href=\"index.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eHome\u003c/a\u003e\n          \u003ca href=\"about.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eAbout Us\u003c/a\u003e\n\n          \u003cdiv class=\"nav-item dropdown\"\u003e\n            \u003c!--\u003ca href=\"service.html\" data-bs-toggle=\"dropdown\" class=\"nav-link active\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eOur OFFERINGS\u003c/a\u003e--\u003e\n            \u003cdiv class=\"dropdown-menu custom-dropdown\"\u003e\n \n  \u003ca href=\"https://truepromise.co.in/warranty/\" class=\"dropdown-item\" style=\"font-weight:600;font-family: Poppins;\"\u003eAutomobiles Warranty\u003c/a\u003e\n   \u003c!--\u003ca href=\"2W.html\" class=\"dropdown-item\"\u003eTwo Wheeler Warranty\u003c/a\u003e--\u003e\n  \u003ca href=\"#\" class=\"dropdown-item\" style=\"font-weight:600;font-family: Poppins;\"\u003eConsumer Durables Warranty\u003c/a\u003e\n\u003c/div\u003e\n          \u003c/div\u003e\n \u003ca href=\"partnerwithuse.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003e Partner With Us \u003c/a\u003e\n          \u003ca href=\"contact.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eContact Us\u003c/a\u003e\n\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003c!-- \u003cdiv class=\"buttonforhidden\"\u003e\n        \u003cbutton style=\"border-radius: 12px;color: white; backdrop-filter: blur(1px);\n    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1) ; padding: 5px 10px 5px \n    10px ; \"\u003e Login \u003c/button\u003e \n        \u003cbutton style=\"background-color: #2d286b; color: white; border: 2px solid #2d286b; border-radius: 3px; padding: 5px 10px 5px 10px;\"\u003e Sign up \u003c/button\u003e\n      \u003c/div\u003e --\u003e\n    \n    \u003c/nav\u003e\n\n  \u003c!-- Navbar End --\u003e\n\n\n  \u003c!-- Page Header Start --\u003e\n  \u003cdiv class=\"container-fluid page-header py-5 mb-5 wow fadeIn\" data-wow-delay=\"0.1s\" \n    style=\"background:  url('./img/darkbg.jpg'); background-size: cover; background-position: center; height: 148px; \"\n    \u003e\n\n    \n    \n  \u003c/div\u003e\n  \u003c!-- Page Header End --\u003e\n\n  \u003c!-- Contact Start --\u003e\n  \u003cdiv class=\"container-xxl py-5\"\u003e\n    \u003cdiv class=\"container\"\u003e\n      \u003cdiv class=\"row g-5\" style=\"    position: relative;\n    bottom: 50px;\"\u003e\n        \u003cdiv class=\"col-lg-6 wow fadeIn\" data-wow-delay=\"0.1s\"\u003e\n          \u003ch1 class=\"display-6 mb-5\" style=\"color: #000000;font-size:30px\"\u003e\n            If You Have Any Query, Please Contact Us\n          \u003c/h1\u003e\n          \u003cp class=\"mb-4\"\u003e\n            \n          \u003c/p\u003e\n          \u003cform\u003e\n            \u003cdiv class=\"row g-3\" style=\"position: relative;\n    bottom: 20px;\"\u003e\n              \u003cdiv class=\"col-md-6\"\u003e\n                \u003cdiv class=\"form-floating\"\u003e\n                  \u003cinput type=\"text\" class=\"form-control\" id=\"name\" placeholder=\"Your Name\" /\u003e\n                  \u003clabel for=\"name\" style=\"font-family:poppins!important\"\u003eYour Name\u003c/label\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"col-md-6\"\u003e\n                \u003cdiv class=\"form-floating\"\u003e\n                  \u003cinput type=\"email\" class=\"form-control\" id=\"email\" placeholder=\"Your Email\" /\u003e\n                  \u003clabel for=\"email\" style=\"font-family:poppins!important\"\u003eYour Email\u003c/label\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"col-12\"\u003e\n                \u003cdiv class=\"form-floating\"\u003e\n                  \u003cinput type=\"text\" class=\"form-control\" id=\"subject\" placeholder=\"Subject\" /\u003e\n                  \u003clabel for=\"subject\" style=\"font-family:poppins!important\"\u003eSubject\u003c/label\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"col-12\"\u003e\n                \u003cdiv class=\"form-floating\"\u003e\n                  \u003ctextarea class=\"form-control\" placeholder=\"Leave a message here\" id=\"message\"\n                    style=\"height: 100px\"\u003e\u003c/textarea\u003e\n                  \u003clabel for=\"message\" style=\"font-family:poppins!important\"\u003eMessage\u003c/label\u003e\n                \u003c/div\u003e\n              \u003c/div\u003e\n              \u003cdiv class=\"col-12\" style=\"position: relative;\n    top: 15px;\"\u003e\n                \u003cbutton class=\"btn btn-primary py-3 px-5\" type=\"submit\" style=\"background-color: #2D286B;\" \u003e\n                  Send Message\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/form\u003e\n      \n        \u003c/div\u003e\n\n        \n               \u003c!-- RIGHT: MAP --\u003e\n        \u003cdiv class=\"col-lg-6 wow fadeIn\" data-wow-delay=\"0.5s\"\u003e\n          \u003cdiv class=\"map-container\"\u003e\n            \u003ch2 style=\"font-size:26px\"\u003eNationwide Footprint \u003c/h2\u003e\n            \u003cdiv id=\"map\"\u003e\u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e \u003c!-- Contact End wrapper closes here --\u003e\n\n  \u003c!-- Map Scripts --\u003e\n  \u003cscript src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"\u003e\u003c/script\u003e\n\n  \u003cscript\u003e\n    const map = L.map(\"map\", {\n      zoomControl: false,\n      scrollWheelZoom: false,\n      doubleClickZoom: false,\n      touchZoom: false\n    }).setView([22.5, 79.5], 5);\n\n    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {\n      maxZoom: 19,\n      subdomains: 'abcd',\n      attribution: '\u0026copy; OpenStreetMap contributors \u0026copy; CARTO'\n    }).addTo(map);\n\n    const ewiIcon = L.divIcon({\n      className: \"\",\n      html: '\u003cdiv class=\"map-pin\"\u003e\u003c/div\u003e',\n      iconSize: [26, 26],\n      iconAnchor: [13, 26],\n      popupAnchor: [0, -26]\n    });\n\n    const locations = [\n      { name: \"Delhi-NCR\", lat: 28.6139, lng: 77.2090 },\n      { name: \"Dehradun\", lat: 30.3165, lng: 78.0322 },\n      { name: \"Jaipur\", lat: 26.9124, lng: 75.7873 },\n      { name: \"Jodhpur\", lat: 26.2389, lng: 73.0243 },\n      { name: \"Gwalior\", lat: 26.2183, lng: 78.1828 },\n      { name: \"Lucknow\", lat: 26.8467, lng: 80.9462 },\n      { name: \"Ahmedabad\", lat: 23.0225, lng: 72.5714 },\n      { name: \"Mumbai\", lat: 19.0760, lng: 72.8777 },\n      { name: \"Pune\", lat: 18.5204, lng: 73.8567 },\n      { name: \"Aurangabad\", lat: 19.8762, lng: 75.3433 },\n      { name: \"Nagpur\", lat: 21.1458, lng: 79.0882 },\n      { name: \"Bhopal\", lat: 23.2599, lng: 77.4126 },\n      { name: \"Hyderabad\", lat: 17.3850, lng: 78.4867 },\n      { name: \"Bangalore\", lat: 12.9716, lng: 77.5946 },\n      { name: \"Chennai\", lat: 13.0827, lng: 80.2707 },\n      { name: \"Coimbatore\", lat: 11.0168, lng: 76.9558 },\n      { name: \"Cochin\", lat: 9.9312, lng: 76.2673 },\n      { name: \"Madurai\", lat: 9.9252, lng: 78.1198 },\n      { name: \"Goa\", lat: 15.4909, lng: 73.8278 },\n      { name: \"Raipur\", lat: 21.2514, lng: 81.6296 },\n      { name: \"Ranchi\", lat: 23.3441, lng: 85.3096 },\n      { name: \"Patna\", lat: 25.5941, lng: 85.1376 },\n      { name: \"Kolkata\", lat: 22.5726, lng: 88.3639 },\n      { name: \"Bhubaneswar\", lat: 20.2961, lng: 85.8245 },\n      { name: \"Guwahati\", lat: 26.1445, lng: 91.7362 }\n    ];\n\n    locations.forEach(loc =\u003e {\n      L.marker([loc.lat, loc.lng], { icon: ewiIcon })\n        .addTo(map)\n        .bindPopup(`\u003cb\u003e${loc.name}\u003c/b\u003e`);\n    });\n  \u003c/script\u003e\n\n  \u003c!-- Scripts --\u003e\n  \u003cscript src=\"https://code.jquery.com/jquery-3.4.1.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"lib/wow/wow.min.js\"\u003e\u003c/script\u003e\n  \u003cscript src=\"js/main.js\"\u003e\u003c/script\u003e\n\n    \n  \n  \u003c!-- Contact End --\u003e\n\n  \u003cfooter class=\"footer\"\u003e\n      \u003cdiv class=\"container\"\u003e\n        \u003cdiv class=\"row\"\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch1 class=\"footer-logo\"\u003e\n              \u003cimg src=\"./img/EW-Logo 4.png\" alt=\"Logo\" /\u003e\n            \u003c/h1\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\n              Our extended warranty plans safeguard the products you rely on\n              every day—keeping them running smoothly and extending their\n              lifespan. From mobility to home essentials, we’ve got you covered.\n            \u003c/p\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003eAddress\u003c/h5\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\n              \u003ci class=\"fa fa-map-marker-alt me-3\"\u003e\u003c/i\u003eExtended Warranty India\n              Private Limited 215, First Floor, DLF South Court Mall, Saket, New\n              Delhi, 110017\n            \u003c/p\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-phone-alt me-3\"\u003e\u003c/i\u003e+011 49880000\u003c/p\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-envelope me-3\"\u003e\u003c/i\u003econtact@warrantyindia.co.in\u003c/p\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size:18px;font-family: Poppins;\"\u003e\n              Quick Links\n            \u003c/h5\u003e\n            \u003cul class=\"list-unstyled\" \u003e\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"about.html\" style=\"font-family: Poppins;font-size:14px\"\u003eAbout Us\u003c/a\u003e\u003c/li\u003e\n              \u003cli\u003e\n                \u003ca class=\"btn btn-link\" href=\"contact.html\" style=\"font-family: Poppins;font-size:14px\"\u003eContact Us\u003c/a\u003e\n              \u003c/li\u003e\n              \u003cli\u003e\u003ca class=\"btn btn-link\" href=\"terms-and-conditions.html\" style=\"font-family: Poppins;font-size:14px\"\u003eTerms \u0026 Conditions\u003c/a\u003e\u003c/li\u003e\n              \u003cli\u003e\n                \u003ca class=\"btn btn-link\" href=\"privacy-policy.html\" style=\"font-family: Poppins;font-size:14px\"\u003ePrivacy Policy\u003c/a\u003e\n              \u003c/li\u003e\n            \u003c/ul\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003e\n              OUR SERVICES\n            \u003c/h5\u003e\n           \u003cstyle\u003e\n  .btn-link {\n    display: block;\n  }\n  .list-unstyled .btn-link {\n    white-space: nowrap;\n    font-family: Poppins;\n    font-size:14px;\n  }/* Remove underline from footer links */\n.footer a.btn-link {\n    text-decoration: none !important;\n}\n\n/* Also remove underline on hover */\n.footer a.btn-link:hover {\n    text-decoration: none !important;\n}\n/* ===== FOOTER LEFT ALIGN FIX ===== */\n.footer,\n.footer * {\n  text-align: left !important;\n}\n\n/* Footer links */\n.footer .btn-link {\n  text-align: left !important;\n  padding-left: 0;\n}\n\n/* Remove center alignment added earlier */\n.footer .btn-link {\n  display: inline-block;\n}\n\n/* Footer columns spacing */\n.footer .col-md-3,\n.footer .col-md-6 {\n  text-align: left !important;\n}\n\n/* Footer logo alignment */\n.footer-logo img {\n  display: block;\n  margin-left: 0;\n}\n\n/* Footer bottom text */\n.footer-bottom {\n  text-align: left;\n}\n\n\u003c/style\u003e\n\n\u003cul class=\"list-unstyled\"\u003e\n  \u003cli \u003e\n    \u003ca class=\"btn btn-link\" href=\"https://truepromise.co.in/warranty/\"\u003eAutomobiles Warranty\u003c/a\u003e\n  \u003c/li\u003e\n  \n  \u003cli\u003e\n    \u003ca class=\"btn btn-link\" href=\"https://extracare.co.in/ExtraCare/assimox-html-package/assimox-html-main/index.html\"\u003eElectronics \u0026 Home Appliances\u003c/a\u003e\n  \u003c/li\u003e\n\u003c/ul\u003e\n\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"footer-bottom\"\u003e\n          \u003cdiv class=\"col-md-6 text-md-start mb-3 mb-md-0\"\u003e\n            © \u003ca style=\"color: #007bff;font-family: Poppins;font-size:14px\"\u003eExtended Warranty\u003c/a\u003e, All\n            Right Reserved.\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/footer\u003e\n\n  \u003c!-- Footer End --\u003e\n\n  \u003c!-- Back to Top --\u003e\n\u003ca href=\"#\" class=\"btn btn-lg btn-primary btn-lg-square back-to-top\" style=\"background-color: #110F3A; display: flex; justify-content: center; align-items: center; padding: 0;\"\u003e\n      \u003ci class=\"bi bi-arrow-up\" style=\"font-size: 25px;\"\u003e\u003c/i\u003e\n    \u003c/a\u003e\n    \n    \n\u003c/body\u003e\n\n\u003c/html\u003e","content_type":"text/html","method":"GET","host":"warrantyindia.com","host_ip":"101.53.149.53","path":"/contact.html","header":{"accept_ranges":"bytes","content_length":"15829","content_type":"text/html","date":"Fri, 18 Sep 2026 14:54:14 GMT","last_modified":"Wed, 17 Dec 2025 11:07:48 GMT","server":"Apache"},"raw_header":"HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: 15829\r\nAccept-Ranges: bytes\r\nContent-Type: text/html\r\nDate: Fri, 18 Sep 2026 14:54:14 GMT\r\nLast-Modified: Wed, 17 Dec 2025 11:07:48 GMT\r\nServer: Apache\r\n\r\n","request":"GET /contact.html HTTP/1.1\r\nHost: warrantyindia.com\r\nUser-Agent: Mozilla/5.0 (X11; Ubuntu; Linux x86_64; rv:85.0) Gecko/20100101 Firefox/91.0\r\nAccept-Charset: utf-8\r\nAccept-Encoding: gzip\r\n\r\n","time":"463.587997ms","a":["101.53.149.53"],"tech":["Apache HTTP Server","Bootstrap:5.0.0","OWL Carousel","Unpkg","WOW","jQuery CDN","jQuery:3.4.1","jsDelivr"],"words":3297,"lines":458,"status_code":200,"content_length":15829,"failed":false,"knowledgebase":{"Forms":[{"type":"contact/comment"}],"PageType":"contact","pHash":0},"resolvers":["[2409:40d0:250b:70b2::de]:53","1.1.1.1:53"]}
