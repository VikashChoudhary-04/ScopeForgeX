ite; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003e Partner With Us \u003c/a\u003e\n          \u003ca href=\"contact.html\" class=\"nav-item nav-link\" style=\"color: white; font-size: 16px; text-transform: uppercase;font-weight:600;font-family: Poppins;\"\u003eContact Us\u003c/a\u003e\n\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003c!-- \u003cdiv class=\"buttonforhidden\"\u003e\n        \u003cbutton style=\"border-radius: 12px;color: white; backdrop-filter: blur(1px);\n    background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1) ; padding: 5px 10px 5px \n    10px ; \"\u003e Login \u003c/button\u003e \n        \u003cbutton style=\"background-color: #2d286b; color: white; border: 2px solid #2d286b; border-radius: 3px; padding: 5px 10px 5px 10px;\"\u003e Sign up \u003c/button\u003e\n      \u003c/div\u003e --\u003e\n    \n    \u003c/nav\u003e\n\n  \u003c!-- Navbar End --\u003e\n\n  \u003c!-- Page Header Start --\u003e\n  \u003c!--\u003cdiv class=\"container-fluid page-header py-5 mb-5 wow fadeIn\" data-wow-delay=\"0.1s\"--\u003e\n  \u003c!--style=\"background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('./img/About_us.jpg'); background-size: cover; background-position: center; height:400px\"\u003e--\u003e\n      \n      \u003cdiv class=\"container-fluid page-header py-5 mb-5 wow fadeIn\" data-wow-delay=\"0.1s\"\n  style=\"background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('./img/darkbg.jpg'); background-size: cover; background-position: center; height:148px;position:fixed\"\u003e\n\n\n    \u003cdiv class=\"container py-5\"\u003e\n      \u003c!--\u003ch3 class=\"display-4 animated slideInDown mb-4\" style=\" color: white;white-space: nowrap; position: relative;top: 71px;font-size:45px!important\"\u003e CONNECT WITH US\u003c/h3\u003e--\u003e\n     \n    \u003c/div\u003e\n  \u003c/div\u003e\n\n\n  \u003c!-- Footer Start --\u003e\n\u003c!-- Partner With Us Section --\u003e\n\u003csection id=\"partner-with-us\" style=\"padding: 60px 0;\"\u003e\n  \u003cdiv class=\"container\" style=\"max-width: 1180px; margin: 0 auto;margin-top:130px\"\u003e\n\n    \u003c!-- Top row --\u003e\n    \u003cdiv class=\"row align-items-center mb-5\" style=\"margin-bottom: 3rem !important; align-items: center;\"\u003e\n      \u003cdiv class=\"col-lg-7\" style=\"margin-bottom: 1.5rem;\"\u003e\n        \u003ch1\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 700;\n            font-size: 30px;\n            line-height: 1.35;\n            color: #000000;\n            margin: 0 0 12px;\n          \"\u003e\n          Grow Your Business with Seamless Warranty \u0026amp; Service Solutions\n        \u003c/h1\u003e\n\n        \u003cp\n          style=\"\n            font-size: 15px;\n            color: #555;\n            margin: 0 0 20px;\n            max-width: 540px;\n          \"\u003e\n          Collaborate with us to offer extended warranty \u0026amp; protection plans\n          for automobiles, electronics and home appliances. Unlock new revenue streams,\n          enhance customer loyalty, and deliver peace of mind with every sale.\n        \u003c/p\u003e\n\n        \u003cdiv style=\"display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 18px;\"\u003e\n          \u003c!-- Become a Partner button --\u003e\n          \u003ca href=\"#partner-form\"\n             class=\"btn\"\n             style=\"\n               font-family: 'Poppins', sans-serif;\n               font-weight: 500;\n               font-size: 14px;\n               text-transform: uppercase;\n               letter-spacing: 0.08em;\n               border-radius: 999px;\n               padding: 10px 26px;\n               background: linear-gradient(135deg, #2d286b, #4b43a7);\n               border: none;\n               color: #ffffff;\n               box-shadow: 0 10px 25px rgba(45, 40, 107, 0.45);\n             \"\u003e\n            Become a Partner\n          \u003c/a\u003e\n\n         \n        \u003c/div\u003e\n\n        \u003cdiv style=\"margin-top: 16px; font-size: 14px; color: #777;font-family:poppins!important\"\u003e\n          Perfect for: Automobile Dealers \u0026bull; OEMs \u0026bull; Distributors \u0026bull; Retailers \u0026bull; Service Centers\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-lg-5 mt-4 mt-lg-0 text-center\"\u003e\n     \u003cdiv style=\"\n    width: 100%;\n    height: 350px;\n    background:\n        linear-gradient(rgba(15,7,40,0.40), rgba(33,7,40,-1.8)),\n        url('./img/partner-with-us1.jpg') center/cover no-repeat;\n    border-radius: 10px;\n\"\u003e\u003c/div\u003e\n\n\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Stats --\u003e\n    \u003cdiv class=\"row text-center mb-5\" style=\"margin-bottom: 3rem !important; text-align: center;\"\u003e\n      \u003cdiv class=\"col-md-4 col-6 mb-3\"\n           style=\"\n             padding: 18px 10px;\n             border-radius: 16px;\n             background: #ffffff;\n             border: 1px solid rgba(223, 226, 247, 0.9);\n             box-shadow: 0 10px 30px rgba(20, 26, 85, 0.08);\n             margin-bottom: 1rem !important;\n           \"\u003e\n        \u003ch3\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 700;\n            color: #2d286b;\n            margin: 0 0 4px;\n          \"\u003e\n          1000+\n        \u003c/h3\u003e\n        \u003cp style=\"font-size: 14px; margin: 0; color: #666;\"\u003e\n          Active Dealer Partners\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-md-4 col-6 mb-3\"\n           style=\"\n             padding: 18px 10px;\n             border-radius: 16px;\n             background: #ffffff;\n             border: 1px solid rgba(223, 226, 247, 0.9);\n             box-shadow: 0 10px 30px rgba(20, 26, 85, 0.08);\n             margin-bottom: 1rem !important;\n           \"\u003e\n        \u003ch3\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 700;\n            color: #2d286b;\n            margin: 0 0 4px;\n          \"\u003e\n          PAN India\n        \u003c/h3\u003e\n        \u003cp style=\"font-size: 14px; margin: 0; color: #666;\"\u003e\n          Service Network\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-md-4 col-6 mb-3\"\n           style=\"\n             padding: 18px 10px;\n             border-radius: 16px;\n             background: #ffffff;\n             border: 1px solid rgba(223, 226, 247, 0.9);\n             box-shadow: 0 10px 30px rgba(20, 26, 85, 0.08);\n             margin-bottom: 1rem !important;\n           \"\u003e\n        \u003ch3\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 700;\n            color: #2d286b;\n            margin: 0 0 4px;\n          \"\u003e\n          24x7\n        \u003c/h3\u003e\n        \u003cp style=\"font-size: 14px; margin: 0; color: #666;\"\u003e\n          Support \u0026amp; Claims\n        \u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Why Partner --\u003e\n    \u003cdiv class=\"row mb-4\" style=\"margin-bottom: 2.5rem !important;\"\u003e\n      \u003cdiv class=\"col-12 text-center mb-4\" style=\"margin-bottom: 1.6rem !important;\"\u003e\n        \u003ch2\n          style=\"\n            font-weight: 700;\n            font-size: 26px;\n            color: #212121;\n            margin: 0 0 8px;\n            font-family: 'Poppins', sans-serif;\n          \"\u003e\n          Why Partner With Us\n        \u003c/h2\u003e\n        \u003cp\n          style=\"\n            font-size: 14px;\n            color: #555;\n            max-width: 650px;\n            margin: 10px auto 0;\n          \"\u003e\n          We provide a complete extended warranty ecosystem – from product\n          design to claims settlement – so you can focus on sales while we\n          handle the rest.\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-md-4 mb-3\" style=\"margin-bottom: 1rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            background: #ffffff;\n            border-radius: 16px;\n            border: 1px solid #e2e4f0;\n            padding: 18px 18px 16px;\n            box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n          \"\u003e\n          \u003ch5\n            style=\"\n              font-family: 'Poppins', sans-serif;\n              font-weight: 600;\n              color: #2d286b;\n              margin: 0 0 6px;\n            \"\u003e\n            New Revenue Streams\n          \u003c/h5\u003e\n          \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n            Earn attractive margins on every warranty plan sold while\n            adding more value to your customers.\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-md-4 mb-3\" style=\"margin-bottom: 1rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            background: #ffffff;\n            border-radius: 16px;\n            border: 1px solid #e2e4f0;\n            padding: 18px 18px 16px;\n            box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n          \"\u003e\n          \u003ch5\n            style=\"\n              font-family: 'Poppins', sans-serif;\n              font-weight: 600;\n              color: #2d286b;\n              margin: 0 0 6px;\n            \"\u003e\n            End-to-End Digital Portal\n          \u003c/h5\u003e\n          \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n            Simple web \u0026amp; mobile platforms for policy issuance, claim\n            tracking, MIS and performance reports.\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-md-4 mb-3\" style=\"margin-bottom: 1rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            background: #ffffff;\n            border-radius: 16px;\n            border: 1px solid #e2e4f0;\n            padding: 18px 18px 16px;\n            box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n          \"\u003e\n          \u003ch5\n            style=\"\n              font-family: 'Poppins', sans-serif;\n              font-weight: 600;\n              color: #2d286b;\n              margin: 0 0 6px;\n            \"\u003e\n            Zero Operational Burden\n          \u003c/h5\u003e\n          \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n            We handle underwriting, documentation, customer support and\n            the complete claims process.\n          \u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Who can partner --\u003e\n    \u003cdiv class=\"row mb-4\" style=\"margin-bottom: 2.5rem !important;\"\u003e\n      \u003cdiv class=\"col-lg-5 mb-3 mb-lg-0\" style=\"margin-bottom: 1.5rem !important;\"\u003e\n        \u003ch2\n          style=\"\n            font-weight: 700;\n            font-size: 24px;\n            color: #212121;\n            font-family: 'Poppins', sans-serif;\n            margin: 0 0 10px;\n          \"\u003e\n          Who Can Partner With Us\n        \u003c/h2\u003e\n        \u003cp style=\"font-size: 14px; color: #555; margin: 10px 0 8px;\"\u003e\n          Our partnership programs are designed for businesses catering to\n          customers across vehicles \u0026amp; appliances:\n        \u003c/p\u003e\n        \u003cul\n          style=\"\n            font-size: 14px;\n            color: #555;\n            padding-left: 18px;\n            margin-top: 8px;\n            margin-bottom: 0;\n            font-family:Poppins !important;\n          \"\u003e\n          \u003cli style=\"font-size:14px;font-family:Poppins\"\u003eAutomobile dealers (2W/4W/EV)\u003c/li\u003e\n          \u003cli style=\"font-size:14px;font-family:Poppins\"\u003eHome appliance \u0026amp; electronics retailers\u003c/li\u003e\n          \u003cli style=\"font-size:14px;font-family:Poppins\"\u003eOEMs \u0026amp; Manufacturers\u003c/li\u003e\n          \u003cli style=\"font-size:14px;font-family:Poppins\"\u003eService centers \u0026amp; workshops\u003c/li\u003e\n          \u003cli style=\"font-size:14px;font-family:Poppins\"\u003eCorporate \u0026amp; institutional clients\u003c/li\u003e\n        \u003c/ul\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"col-lg-7\"\u003e\n        \u003cdiv class=\"row g-3\" style=\"row-gap: 1rem; column-gap: 0;\"\u003e\n          \u003cdiv class=\"col-sm-6\" style=\"margin-bottom: 1rem !important;\"\u003e\n            \u003cdiv\n              style=\"\n                background: #ffffff;\n                border-radius: 16px;\n                border: 1px solid #e2e4f0;\n                padding: 16px 16px 14px;\n                box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n              \"\u003e\n              \u003ch6\n                style=\"\n                  font-family: 'Poppins', sans-serif;\n                  font-weight: 600;\n                  color: #2d286b;\n                  margin: 0 0 6px;\n                \"\u003e\n                Automobile Partners\n              \u003c/h6\u003e\n              \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n                Offer extended warranty at the time of vehicle sale or\n                during service visits for additional protection.\n              \u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cdiv class=\"col-sm-6\" style=\"margin-bottom: 1rem !important;\"\u003e\n            \u003cdiv\n              style=\"\n                background: #ffffff;\n                border-radius: 16px;\n                border: 1px solid #e2e4f0;\n                padding: 16px 16px 14px;\n                box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n              \"\u003e\n              \u003ch6\n                style=\"\n                  font-family: 'Poppins', sans-serif;\n                  font-weight: 600;\n                  color: #2d286b;\n                  margin: 0 0 6px;\n                \"\u003e\n                Appliance Retailers\n              \u003c/h6\u003e\n              \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n                Attach warranty plans to TVs, ACs, refrigerators, washing\n                machines and more in a single click.\n              \u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cdiv class=\"col-sm-6\" style=\"margin-bottom: 1rem !important;\"\u003e\n            \u003cdiv\n              style=\"\n                background: #ffffff;\n                border-radius: 16px;\n                border: 1px solid #e2e4f0;\n                padding: 16px 16px 14px;\n                box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n              \"\u003e\n              \u003ch6\n                style=\"\n                  font-family: 'Poppins', sans-serif;\n                  font-weight: 600;\n                  color: #2d286b;\n                  margin: 0 0 6px;\n                \"\u003e\n                Service Network\n              \u003c/h6\u003e\n              \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n                Become an authorized service partner for inspections,\n                repairs and claim support across locations.\n              \u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n\n          \u003cdiv class=\"col-sm-6\" style=\"margin-bottom: 1rem !important;\"\u003e\n            \u003cdiv\n              style=\"\n                background: #ffffff;\n                border-radius: 16px;\n                border: 1px solid #e2e4f0;\n                padding: 16px 16px 14px;\n                box-shadow: 0 10px 30px rgba(20, 26, 85, 0.05);\n              \"\u003e\n              \u003ch6\n                style=\"\n                  font-family: 'Poppins', sans-serif;\n                  font-weight: 600;\n                  color: #2d286b;\n                  margin: 0 0 6px;\n                \"\u003e\n                OEM / Brand Alliances\n              \u003c/h6\u003e\n              \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n                Co-create customized warranty programs under your brand,\n                backed by our tech \u0026amp; operations team.\n              \u003c/p\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- How it works --\u003e\n    \u003cdiv class=\"row mb-5\" style=\"margin-bottom: 3rem !important;\"\u003e\n      \u003cdiv class=\"col-12 text-center mb-4\" style=\"margin-bottom: 1.8rem !important;\"\u003e\n        \u003ch2\n          style=\"\n            font-weight: 700;\n            font-size: 24px;\n            color: #212121;\n            font-family: 'Poppins', sans-serif;\n            margin: 0;\n          \"\u003e\n          How Partnership Works\n        \u003c/h2\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Step 1 --\u003e\n      \u003cdiv class=\"col-md-3 col-6 mb-3 text-center\" style=\"margin-bottom: 1.4rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            width: 42px;\n            height: 42px;\n            line-height: 42px;\n            border-radius: 50%;\n            margin: 0 auto 8px;\n            text-align: center;\n            font-weight: 600;\n            font-family: 'Poppins', sans-serif;\n            color: #ffffff;\n            background: linear-gradient(135deg, #2d286b, #5649c9);\n            box-shadow: 0 10px 25px rgba(22, 25, 70, 0.4);\n          \"\u003e\n          1\n        \u003c/div\u003e\n        \u003ch6\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 600;\n            color: #1f1c4d;\n            margin: 6px 0 4px;\n          \"\u003e\n          Share Your Details\n        \u003c/h6\u003e\n        \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n          Submit the form below with basic business information.\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Step 2 --\u003e\n      \u003cdiv class=\"col-md-3 col-6 mb-3 text-center\" style=\"margin-bottom: 1.4rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            width: 42px;\n            height: 42px;\n            line-height: 42px;\n            border-radius: 50%;\n            margin: 0 auto 8px;\n            text-align: center;\n            font-weight: 600;\n            font-family: 'Poppins', sans-serif;\n            color: #ffffff;\n            background: linear-gradient(135deg, #2d286b, #5649c9);\n            box-shadow: 0 10px 25px rgba(22, 25, 70, 0.4);\n          \"\u003e\n          2\n        \u003c/div\u003e\n        \u003ch6\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 600;\n            color: #1f1c4d;\n            margin: 6px 0 4px;\n          \"\u003e\n          Program Discussion\n        \u003c/h6\u003e\n        \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n          Our team connects with you to understand your requirements.\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Step 3 --\u003e\n      \u003cdiv class=\"col-md-3 col-6 mb-3 text-center\" style=\"margin-bottom: 1.4rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            width: 42px;\n            height: 42px;\n            line-height: 42px;\n            border-radius: 50%;\n            margin: 0 auto 8px;\n            text-align: center;\n            font-weight: 600;\n            font-family: 'Poppins', sans-serif;\n            color: #ffffff;\n            background: linear-gradient(135deg, #2d286b, #5649c9);\n            box-shadow: 0 10px 25px rgba(22, 25, 70, 0.4);\n          \"\u003e\n          3\n        \u003c/div\u003e\n        \u003ch6\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 600;\n            color: #1f1c4d;\n            margin: 6px 0 4px;\n          \"\u003e\n          Onboarding \u0026amp; Training\n        \u003c/h6\u003e\n        \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n          We set up your login, product matrix, and team training.\n        \u003c/p\u003e\n      \u003c/div\u003e\n\n      \u003c!-- Step 4 --\u003e\n      \u003cdiv class=\"col-md-3 col-6 mb-3 text-center\" style=\"margin-bottom: 1.4rem !important;\"\u003e\n        \u003cdiv\n          style=\"\n            width: 42px;\n            height: 42px;\n            line-height: 42px;\n            border-radius: 50%;\n            margin: 0 auto 8px;\n            text-align: center;\n            font-weight: 600;\n            font-family: 'Poppins', sans-serif;\n            color: #ffffff;\n            background: linear-gradient(135deg, #2d286b, #5649c9);\n            box-shadow: 0 10px 25px rgba(22, 25, 70, 0.4);\n          \"\u003e\n          4\n        \u003c/div\u003e\n        \u003ch6\n          style=\"\n            font-family: 'Poppins', sans-serif;\n            font-weight: 600;\n            color: #1f1c4d;\n            margin: 6px 0 4px;\n          \"\u003e\n          Go Live \u0026amp; Grow\n        \u003c/h6\u003e\n        \u003cp style=\"font-size: 14px; color: #555; margin: 0;\"\u003e\n          Start issuing warranties, track performance and grow revenues.\n        \u003c/p\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Partner form --\u003e\n    \u003cdiv id=\"partner-form\" class=\"row justify-content-center\"\u003e\n      \u003cdiv class=\"col-lg-8\"\u003e\n        \u003cdiv\n          class=\"p-4 p-md-5 rounded\"\n          style=\"\n            border-radius: 18px !important;\n            border: 1px solid #e2e2f0;\n            background: linear-gradient(135deg, #ffffff, #f8f7ff);\n            box-shadow: 0 18px 45px rgba(16, 22, 58, 0.12);\n            padding: 24px 22px;\n          \"\u003e\n          \u003ch3\n            style=\"\n              font-weight: 700;\n              font-size: 20px;\n              color: #2d286b;\n              margin: 0 0 12px;\n              font-family: 'Poppins', sans-serif;\n            \"\u003e\n            Share Your Interest\n          \u003c/h3\u003e\n          \u003cp style=\"font-size: 14px; color: #666; margin: 0 0 18px;font-family:poppins!important\"\u003e\n            Fill in the details below and our partnership team will get in\n            touch with you.\n          \u003c/p\u003e\n\n          \u003cform action=\"partner-enquiry-submit.php\" method=\"post\"\u003e\n            \u003cdiv class=\"row g-3\" style=\"row-gap: 1rem; column-gap: 0;\"\u003e\n              \u003cdiv class=\"col-md-6\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  Full Name *\n                \u003c/label\u003e\n                \u003cinput type=\"text\" name=\"name\" class=\"form-control\"\n                       required\n                       style=\"\n                         font-size: 14px;\n                         border-radius: 10px;\n                         border: 1px solid #d9def0;\n                         padding: 9px 11px;\n                       \" /\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-md-6\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  Company / Dealership Name *\n                \u003c/label\u003e\n                \u003cinput type=\"text\" name=\"company\" class=\"form-control\"\n                       required\n                       style=\"\n                         font-size: 14px;\n                         border-radius: 10px;\n                         border: 1px solid #d9def0;\n                         padding: 9px 11px;\n                       \" /\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-md-6\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  Email *\n                \u003c/label\u003e\n                \u003cinput type=\"email\" name=\"email\" class=\"form-control\"\n                       required\n                       style=\"\n                         font-size: 14px;\n                         border-radius: 10px;\n                         border: 1px solid #d9def0;\n                         padding: 9px 11px;\n                       \" /\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-md-6\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  Mobile Number *\n                \u003c/label\u003e\n                \u003cinput type=\"text\" name=\"mobile\" class=\"form-control\"\n                       required\n                       style=\"\n                         font-size: 14px;\n                         border-radius: 10px;\n                         border: 1px solid #d9def0;\n                         padding: 9px 11px;\n                       \" /\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-md-6\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  City\n                \u003c/label\u003e\n                \u003cinput type=\"text\" name=\"city\" class=\"form-control\"\n                       style=\"\n                         font-size: 14px;\n                         border-radius: 10px;\n                         border: 1px solid #d9def0;\n                         padding: 9px 11px;\n                       \" /\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-md-6\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  Type of Partnership *\n                \u003c/label\u003e\n                \u003cselect name=\"partner_type\" class=\"form-select\" required\n                        style=\"\n                          font-size: 14px;\n                          border-radius: 10px;\n                          border: 1px solid #d9def0;\n                          padding: 9px 11px;font-family:poppins!important\n                        \"\u003e\n                  \u003coption value=\"\" style=\"font-family:poppins!important\"\u003eSelect\u003c/option\u003e\n                  \u003coption style=\"font-family:poppins!important\"\u003eAutomobile Dealer\u003c/option\u003e\n                  \u003coption style=\"font-family:poppins!important\"\u003eAppliance Retailer\u003c/option\u003e\n                  \u003coption style=\"font-family:poppins!important\"\u003eService Center\u003c/option\u003e\n                  \u003coption style=\"font-family:poppins!important\"\u003eOEM / Manufacturer\u003c/option\u003e\n                  \u003coption style=\"font-family:poppins!important\"\u003eCorporate / Fleet\u003c/option\u003e\n                  \u003coption style=\"font-family:poppins!important\"\u003eOthers\u003c/option\u003e\n                \u003c/select\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-12\" style=\"margin-bottom: 0.8rem !important;\"\u003e\n                \u003clabel class=\"form-label\"\n                       style=\"font-size: 14px; font-weight: 500; color: #444;font-family:poppins!important\"\u003e\n                  Brief About Your Business\n                \u003c/label\u003e\n                \u003ctextarea name=\"message\" rows=\"3\" class=\"form-control\"\n                          placeholder=\"Tell us a little about your business and expected volumes...\"\n                          style=\"\n                            font-size: 14px;\n                            border-radius: 10px;\n                            border: 1px solid #d9def0;\n                            padding: 9px 11px;font-family:poppins!important\n                          \"\u003e\u003c/textarea\u003e\n              \u003c/div\u003e\n\n              \u003cdiv class=\"col-12 text-end\" style=\"text-align: right;\"\u003e\n                \u003cbutton type=\"submit\"\n                        class=\"btn\"\n                        style=\"\n                          font-family: 'Poppins', sans-serif;\n                          font-weight: 500;\n                          font-size: 14px;\n                          text-transform: uppercase;\n                          letter-spacing: 0.08em;\n                          border-radius: 999px;\n                          padding: 10px 26px;\n                          background: linear-gradient(135deg, #2d286b, #4b43a7);\n                          border: none;\n                          color: #ffffff;\n                          box-shadow: 0 10px 25px rgba(45, 40, 107, 0.45);\n                          min-width: 180px;\n                        \"\u003e\n                  Submit Enquiry\n                \u003c/button\u003e\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/form\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n  \u003c/div\u003e\n\u003c/section\u003e\n\n \u003cfooter class=\"footer\"\u003e\n      \u003cdiv class=\"container\"\u003e\n        \u003cdiv class=\"row\"\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch1 class=\"footer-logo\"\u003e\n              \u003cimg src=\"./img/EW-Logo 4.png\" alt=\"Logo\" /\u003e\n            \u003c/h1\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\n              Our extended warranty plans safeguard the products you rely on\n              every day—keeping them running smoothly and extending their\n              lifespan. From mobility to home essentials, we’ve got you covered.\n            \u003c/p\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size: 18px;font-family: Poppins;\"\u003eAddress\u003c/h5\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\n              \u003ci class=\"fa fa-map-marker-alt me-3\"\u003e\u003c/i\u003eExtended Warranty India\n              Private Limited 215, First Floor, DLF South Court Mall, Saket, New\n              Delhi, 110017\n            \u003c/p\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-phone-alt me-3\"\u003e\u003c/i\u003e+011 49880000\u003c/p\u003e\n            \u003cp style=\"font-family: Poppins;font-size:14px\"\u003e\u003ci class=\"fa fa-envelope me-3\"\u003e\u003c/i\u003econtact@warrantyindia.co.in\u003c/p\u003e\n          \u003c/div\u003e\n          \u003cdiv class=\"col-md-3\"\u003e\n            \u003ch5 class=\"text-light mb-4\" style=\"font-size:18px;font-family: Poppins;\"\u003e\n              Quick Links\n            \u003c/h5\u003e\n            \u003cul class=\"list-unstyled\" \u003e\n              \u003cli